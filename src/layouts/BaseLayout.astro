---
const { title = "F5.SI" } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    <header>
       <div class="header-inner">
      <h1>Jakuのサイト</h1>

      <nav>
        <a href="/">ホーム</a>
        <a href="/blog">ブログ</a>
        <a href="/novel">小説</a>
        <a href="/characters">キャラクター</a>
        <a href="/links">リンク</a>
        <a href="/about">Jakuについて</a>
      </nav>
      <button id="theme-toggle">
        🌙
      </button>
      </div>
      <hr />
    </header>

<style is:global>
:root {
  --bg: #ffffff;
  --text: #111111;
  --accent: #0071e3;
  --border: #e5e5e5;
}

:root.dark {
  --bg: #000000;
  --text: #f5f5f7;
  --accent: #2997ff;
  --border: #333333;
}

body {
  margin: 0;

  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  background: var(--bg);
  color: var(--text);

  transition:
    background-color 0.3s ease,
    color 0.3s ease;
}

header {
  max-width: 1100px;
  margin: 0 auto;
  padding: 24px;

  position: sticky;
  top: 0;

  backdrop-filter: blur(20px);

  background: color-mix(
    in srgb,
    var(--bg) 85%,
    transparent
    );

  border-bottom: 1px solid var(--border);

  z-index: 100;
}
.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}
nav {
  display: flex;
  gap: 24px;
  margin-top: 12px;
  align-items: center;
}

nav a {
  text-decoration: none;
  color: var(--text);
}

#theme-toggle {
  margin-top: 16px;

  border: none;
  background: transparent;

  color: var(--text);

  font-size: 1.3rem;
  cursor: pointer;
}
h1 {
  margin: 0;
  font-size: 1.4rem;
}
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(24px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.hero {
  text-align: center;
  animation: fadeUp 0.8s ease;
}

.hero .button {
  margin: 12px;
}
.hero h2 {
  font-size: 5rem;
  margin-bottom: 12px;
}
.hero p {
  max-width: 700px;
  margin-left: auto;
  margin-right: auto;
}
.subtitle {
  font-size: 1.3rem;
  opacity: 0.7;
}
.button {
  display: inline-block;
  padding: 12px 24px;

  border-radius: 999px;

  background: var(--accent);
  color: white;

  text-decoration: none;

  transition:
    transform 0.2s ease,
    opacity 0.2s ease;
}

.button:hover {
  transform: translateY(-2px);
  opacity: 0.9;
}
.cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;

  margin-top: 80px;
}

.card {
  padding: 24px;

  border: 1px solid var(--border);
  border-radius: 20px;

  text-decoration: none;
  color: var(--text);

  backdrop-filter: blur(12px);

  transition:
    transform 0.2s ease,
    border-color 0.2s ease;
}

.card:hover {
  transform: translateY(-4px);
  border-color: var(--accent);
}

.card h3 {
  margin-top: 0;
}
</style>
    <main>
      <slot />
    </main>

  </body>
      <!-- ダークモードJS -->
    <script is:inline>
const button = document.getElementById("theme-toggle");

const savedTheme = localStorage.getItem("theme");

if (savedTheme === "dark") {
  document.documentElement.classList.add("dark");
  button.textContent = "☀️";
}

button.addEventListener("click", () => {
  document.documentElement.classList.toggle("dark");

  if (document.documentElement.classList.contains("dark")) {
    localStorage.setItem("theme", "dark");
    button.textContent = "☀️";
  } else {
    localStorage.setItem("theme", "light");
    button.textContent = "🌙";
  }
});
</script>
</html>