---
const { title = "F5.SI" } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    <header>
      <h1>F5.SI</h1>

      <nav>
        <a href="/">Home</a>
        <a href="/blog">Blog</a>
        <a href="/novel">Novel</a>
        <a href="/characters">Characters</a>
        <a href="/links">Links</a>
        <a href="/about">About</a>
      </nav>

      <hr />
    </header> 
    <style>
      :root{
        --bg:#ffffff;
        --text:#111111;
        --accent:#0071e3;
      }
      body{
        margin:0;
        font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
        background:var(--bg);
        color:var(--text);
      }
      header{
        max-width:1100px;
        margin:0 auto;
        padding:24px;
        position: sticky;
        top: 0;
        backdrop-filter: blur(12px);
        background: rgba(255,255,255,0.8);
        border-bottom: 1px solid #e5e5e5;
        z-index: 100;
      }
      nav{
        display:flex;
        gap:24px;
        margin-top:12px;
        display: flex;
        gap: 24px;
        align-items: center;
      }
      nav a{
        text-decoration:none;
        color:var(--text);
        transition:opacity 0.2s;
      }
      nav a:hover{
        opacity:0.6;
      }
      main{
        max-width:1100px;
        margin:0 auto;
        padding:60px 24px;
      }
      h1{
        margin:0;
      }
     .hero {
  text-align: center;
  padding: 120px 0;
}

.hero h2 {
  font-size: 4rem;
  margin-bottom: 16px;
}

.subtitle {
  font-size: 1.4rem;
  opacity: 0.7;
}

.button {
  display: inline-block;
  margin-top: 24px;
  padding: 12px 24px;
  border-radius: 999px;

  background: #0071e3;
  color: white;

  text-decoration: none;
}

.button:hover {
  opacity: 0.85;
}

    </style>
    <main>
      <slot />
    </main>
  </body>
</html>