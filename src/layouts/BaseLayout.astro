---
const { title = "Jakuのサイト", description = "Jakuの個人サイト" } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/characters/Jaku.svg" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="NWbNGyNv3Gs44SsLOsfA_FMj4IBu4SIdirn_51V7Rlc" />
  </head>

  <body>
    <header>
      <div class="header-inner">
        <h1><a href="/">Jakuのサイト</a></h1>

        <nav id="site-nav" aria-label="メインメニュー">
          <a href="/">ホーム</a>
          <a href="/blog">ブログ</a>
          <a href="/farce">茶番</a>
          <a href="/characters">キャラクター</a>
          <a href="/links">リンク</a>
          <a href="/about">Jakuについて</a>
        </nav>

        <div class="header-actions">
          <button
            id="theme-toggle"
            type="button"
            aria-label="テーマを切り替える"
          >
            🌙
          </button>

          <button
            id="menu-toggle"
            class="menu-toggle"
            type="button"
            aria-label="メニューを開く"
            aria-controls="site-nav"
            aria-expanded="false"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </header>

    <style is:global>
      :root {
        --bg: #ffffff;
        --text: #111111;
        --accent: #0071e3;
        --border: #e5e5e5;
      }
      ::selection {
        background: var(--accent);
        color: white;
      }
      :root.dark {
        --bg: #000000;
        --text: #f5f5f7;
        --accent: #2997ff;
        --border: #333333;
      }
      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: var(--bg);
        color: var(--text);
        transition: background-color 0.3s ease, color 0.3s ease;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(30px);
        background: color-mix(in srgb, var(--bg) 70%, transparent);
        border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
      }

      .header-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        position: relative;
      }

      /* PC用のデフォルトナビゲーション設定 */
      .header-inner nav {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 0;
        align-items: center;
      }

      nav a {
        text-decoration: none;
        color: var(--text);
      }

      #theme-toggle {
        border: 1px solid var(--border);
        border-radius: 999px;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: color-mix(in srgb, var(--bg) 90%, transparent);
        color: var(--text);
        font-size: 1.1rem;
        cursor: pointer;
        transition: transform 0.2s ease, opacity 0.2s ease;
      }

      #theme-toggle:hover {
        transform: scale(1.05);
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
      }

      .menu-toggle {
        display: none;
        width: 42px;
        height: 42px;
        padding: 10px;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--bg);
        color: var(--text);
        cursor: pointer;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 5px;
      }

      .menu-toggle span {
        display: block;
        width: 19px;
        height: 2px;
        border-radius: 2px;
        background: currentColor;
        transition: transform 0.25s ease, opacity 0.2s ease;
      }

      .menu-toggle[aria-expanded="true"] span:first-child {
        transform: translateY(7px) rotate(45deg);
      }

      .menu-toggle[aria-expanded="true"] span:nth-child(2) {
        opacity: 0;
      }

      .menu-toggle[aria-expanded="true"] span:last-child {
        transform: translateY(-7px) rotate(-45deg);
      }

      html.menu-open,
      body.menu-open {
        overflow: hidden;
        overscroll-behavior: none;
      }

      @media (prefers-reduced-motion: reduce) {
        .header-inner nav,
        .menu-toggle span {
          transition: none;
        }
      }

      main {
        max-width: 980px;
        margin: 0 auto;
        padding: 100px 24px;
      }

      h1 {
        margin: 0;
        font-size: 1.4rem;
        white-space: nowrap;
        flex-shrink: 0;
      }

      a {
        color: inherit;
        text-decoration: none;
        transition: color 0.2s ease, opacity 0.2s ease;
      }

      a:hover {
        opacity: 0.8;
      }

      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translateY(24px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .hero {
        text-align: center;
        animation: fadeUp 0.8s ease;
        position: relative;
        overflow: hidden;
        padding: 100px 0 140px;
      }
      .hero::before {
        content: "";
        position: absolute;
        width: 500px;
        height: 500px;
        border-radius: 50%;
        background: radial-gradient(rgba(0,113,227,.25), transparent);
        top: -150px;
        left: 50%;
        transform: translateX(-50%);
        z-index: -1;
      }

      .hero .button {
        margin: 12px;
      }
      .hero h2 {
        font-size: clamp(2.5rem, 10vw, 4rem);
        font-weight: 700;
        letter-spacing: -0.05em;
        margin-bottom: 16px;
        background: linear-gradient(180deg, var(--text), color-mix(in srgb, var(--text) 60%, transparent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .hero p {
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
      }
      .logo-circle {
        width: 180px;
        height: 180px;
        animation: float 4s ease-in-out infinite;
        margin: 0 auto 32px;
        border-radius: 50%;
        overflow: hidden;
        background: linear-gradient(135deg, #0071e3, #6cb6ff);
        box-shadow: 0 0 40px rgba(0,113,227,.3), 0 0 80px rgba(0,113,227,.15);
      }

      .logo-circle img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      @keyframes float {
        0% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
        100% { transform: translateY(0); }
      }
      .subtitle {
        font-size: 1.5rem;
        max-width: 650px;
        margin: 0 auto;
        opacity: .75;
      }
      .button {
        display: inline-block;
        padding: 12px 24px;
        border-radius: 999px;
        background: var(--accent);
        color: white;
        text-decoration: none;
        transition: transform 0.2s ease, opacity 0.2s ease;
      }

      .button:hover {
        transform: translateY(-2px);
        opacity: 0.9;
      }
      .cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
        margin-top: 80px;
        align-items: stretch;
      }

      .card {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
        gap: 34px;
        margin-top: 80px;
        align-items: stretch;
        border-radius: 24px;
        padding: 28px;
        position: relative;
        overflow: hidden;
        border: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
        background: linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,.01));
        backdrop-filter: blur(12px);
        box-shadow: 0 4px 24px rgba(0,0,0,.08);
        transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
      }

      .card:hover {
        transform: translateY(-10px);
        border-color: var(--accent);
        box-shadow: 0 20px 50px rgba(0,0,0,.2);
      }

      .card::before {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
        transition: left 0.6s ease;
      }

      .card:hover::before {
        left: 100%;
      }
      .card h3 {
        margin-top: 0;
      }
      .card h3,
      .card p,
      .card a {
        overflow-wrap: anywhere;
      }
      .character-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: var(--accent);
        margin-bottom: 16px;
      }

      .updates {
        margin-top: 100px;
      }

      .updates h2 {
        text-align: center;
        margin-bottom: 40px;
      }

      .update-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .update-item {
        padding: 20px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: color-mix(in srgb, var(--bg) 90%, transparent);
      }

      .date {
        display: block;
        margin-bottom: 8px;
        font-size: 0.9rem;
        opacity: 0.6;
      }
      article {
        max-width: 800px;
        margin: 0 auto;
        padding: 40px;
        border: 1px solid var(--border);
        border-radius: 24px;
        background: color-mix(in srgb, var(--bg) 92%, transparent);
        backdrop-filter: blur(12px);
        line-height: 1.9;
      }

      article h1 {
        font-size: 3rem;
        margin-bottom: 12px;
        line-height: 1.2;
      }

      article h2 {
        margin-top: 48px;
        margin-bottom: 16px;
        font-size: 1.8rem;
      }

      article p {
        margin-bottom: 20px;
      }

      article a {
        color: var(--accent);
        font-weight: 500;
      }

      article a:hover {
        text-decoration: underline;
      }

      article ul {
        padding-left: 24px;
        margin-bottom: 24px;
      }

      article li {
        margin-bottom: 8px;
      }

      .post-date {
        opacity: 0.6;
        margin-bottom: 32px;
      }

      footer {
        margin-top: 100px;
        padding: 56px 24px 24px;
        border-top: 1px solid var(--border);
        color: var(--text);
      }

      .footer-inner {
        max-width: 1100px;
        margin: 0 auto 48px;
        display: grid;
        grid-template-columns: 1.2fr 1fr 0.8fr;
        gap: 48px;
      }

      .footer-brand,
      .footer-column {
        min-width: 0;
      }

      .footer-logo {
        display: inline-block;
        font-size: 1.8rem;
        font-weight: 750;
        letter-spacing: -0.06em;
      }

      .footer-logo span {
        color: var(--accent);
      }

      .footer-brand > p {
        margin: 10px 0 0;
        font-size: 0.85rem;
        color: var(--text);
        opacity: 0.65;
      }

      .footer-brand .footer-description {
        line-height: 1.8;
      }

      .footer-column h2 {
        margin: 4px 0 20px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
      }

      .footer-nav {
        display: grid;
        gap: 13px;
      }

      .footer-nav a {
        width: fit-content;
        font-size: 0.88rem;
        opacity: 0.7;
        transition: opacity 0.2s ease;
      }

      .footer-nav a:hover {
        opacity: 1;
      }

      .footer-socials {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .footer-social-link {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: color-mix(in srgb, var(--text) 4%, var(--bg));
        transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
      }

      .footer-social-link svg {
        width: 21px;
        height: 21px;
        fill: currentColor;
      }

      .footer-social-link:hover {
        transform: translateY(-3px);
        border-color: var(--accent);
        opacity: 1;
      }

      .youtube-link:hover {
        color: #ff3030;
      }

      .github-link:hover {
        color: var(--accent);
      }

      .footer-social-description {
        margin-top: 14px;
        font-size: 0.8rem;
        line-height: 1.7;
        opacity: 0.65;
      }

      .footer-bottom {
        max-width: 1100px;
        margin: 0 auto;
        padding-top: 22px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
      }

      .footer-bottom p,
      .footer-top-link {
        margin: 0;
        font-size: 0.76rem;
        opacity: 0.65;
      }

      .footer-top-link {
        white-space: nowrap;
      }

      /* ===== スマホ・タブレット用レスポンシブ設定 (768px以下) ===== */
      @media (max-width: 768px) {
        .footer-inner {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 36px 24px;
        }

        .footer-brand {
          grid-column: 1 / -1;
        }

        .cards {
          grid-template-columns: minmax(0, 1fr);
          gap: 16px;
        }

        .menu-toggle {
          display: flex !important;
          align-items: center;
          justify-content: center;
          flex-direction: column;
        }

        /* モバイル用のナビゲーション（ドロップダウンメニュー）スタイル */
        .header-inner nav {
          display: flex;
          position: absolute;
          top: calc(100% + 12px);
          left: 0;
          right: 0;
          z-index: 100;
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          padding: 8px;
          border: 1px solid var(--border);
          border-radius: 16px;
          background: var(--bg);
          box-shadow: 0 12px 32px rgb(0 0 0 / 12%);

          opacity: 0;
          visibility: hidden;
          pointer-events: none;
          transform: translateY(-8px) scale(0.98);
          transform-origin: top;
          transition:
            opacity 0.22s ease,
            transform 0.22s ease,
            visibility 0.22s;
        }

        .header-inner nav.is-open {
          opacity: 1;
          visibility: visible;
          pointer-events: auto;
          transform: translateY(0) scale(1);
          transition:
            opacity 0.22s ease,
            transform 0.22s ease,
            visibility 0s;
        }

        .header-inner nav a {
          display: block;
          padding: 14px 16px;
          border-radius: 10px;
        }

        .header-inner nav a:hover {
          background: var(--border);
        }
      }

      @media (max-width: 480px) {
        footer {
          padding: 40px 20px 20px;
        }

        .footer-inner {
          grid-template-columns: 1fr;
          gap: 32px;
          margin-bottom: 36px;
        }

        .footer-brand {
          grid-column: auto;
        }

        .footer-bottom {
          align-items: flex-start;
          flex-direction: column;
          gap: 12px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .footer-social-link,
        .footer-nav a {
          transition: none;
        }
      }
    </style>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="/" class="footer-logo">Jakuのサイト<span>.</span></a>
          <p class="footer-description">
            Jakuの好きなもの、いろいろ
          </p>
          <p>自分の趣味や関心事を作っています</p>
        </div>

        <div class="footer-column">
          <h2>サイトメニュー</h2>
          <nav class="footer-nav" aria-label="フッターメニュー">
            <a href="/">ホーム</a>
            <a href="/blog">ブログ</a>
            <a href="/farce">茶番</a>
            <a href="/characters">キャラクター</a>
            <a href="/links">リンク</a>
            <a href="/about">Jakuについて</a>
            <a href="/bug-report">バグ報告</a>
          </nav>
        </div>

        <div class="footer-column">
          <h2>FOLLOW ME</h2>

          <div class="footer-socials">
            <a
              class="footer-social-link"
              href="https://x.com/Jaku_1023"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="X（旧Twitter）"
              title="X"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.59-6.64 7.59H.47l8.6-9.83L0 1.15h7.59l5.24 6.93zM17.61 20.64h2.04L6.49 3.24H4.3z" />
              </svg>
            </a>

            <a
              class="footer-social-link youtube-link"
              href="https://www.youtube.com/@Jaku-1023"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTubeチャンネル"
              title="YouTube"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z" />
              </svg>
            </a>

            <a
              class="footer-social-link github-link"
              href="https://github.com/saijaku1"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHubプロフィール"
              title="GitHub"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 .8a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.16c-3.22.7-3.9-1.36-3.9-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.69 1.25 3.35.95.1-.74.4-1.25.73-1.54-2.57-.29-5.27-1.29-5.27-5.73 0-1.27.45-2.3 1.19-3.12-.12-.29-.52-1.47.11-3.07 0 0 .97-.31 3.16 1.19a10.97 10.97 0 0 1 5.75 0c2.19-1.5 3.15-1.19 3.15-1.19.63 1.6.24 2.78.12 3.07.74.82 1.19 1.85 1.19 3.12 0 4.45-2.71 5.43-5.29 5.72.42.36.78 1.06.78 2.14v3.2c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .8Z" />
              </svg>
            </a>
          </div>

          <p class="footer-social-description">
            X・YouTube・GitHubで活動中
          </p>
        </div>
      </div>

      <div class="footer-bottom">
        <p>© 2026 Jakuのサイト. All rights reserved.</p>
        <a href="#top" class="footer-top-link">ページ上部へ ↑</a>
      </div>
    </footer>

    <!-- ダークモードJS -->
    <script is:inline>
      const button = document.getElementById("theme-toggle");
      const savedTheme = localStorage.getItem("theme");

      if (savedTheme === "dark") {
        document.documentElement.classList.add("dark");
        button.textContent = "☀️";
      }

      button.addEventListener("click", () => {
        document.documentElement.classList.toggle("dark");

        if (document.documentElement.classList.contains("dark")) {
          localStorage.setItem("theme", "dark");
          button.textContent = "☀️";
        } else {
          localStorage.setItem("theme", "light");
          button.textContent = "🌙";
        }
      });
    </script>

    <script>
      import Lenis from "lenis";

      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (!prefersReducedMotion) {
        const lenis = new Lenis({
          autoRaf: true,
          lerp: 0.1,
          smoothWheel: true,
          syncTouch: false,
        });
      }

      const menuToggle = document.querySelector("#menu-toggle");
        const siteNav = document.querySelector("#site-nav");

        if (menuToggle && siteNav) {
        const closeMenu = () => {
          siteNav.classList.remove("is-open");
          menuToggle.setAttribute("aria-expanded", "false");
          menuToggle.setAttribute("aria-label", "メニューを開く");
          document.body.classList.remove("menu-open");
        };

        menuToggle.addEventListener("click", () => {
          const isOpen = menuToggle.getAttribute("aria-expanded") === "true";

          if (isOpen) {
            closeMenu();
          } else {
            siteNav.classList.add("is-open");
            menuToggle.setAttribute("aria-expanded", "true");
            menuToggle.setAttribute("aria-label", "メニューを閉じる");
            document.body.classList.add("menu-open");
          }
        });

        siteNav.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", closeMenu);
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            closeMenu();
          }
        });

        window.addEventListener("resize", () => {
          if (window.innerWidth > 768) {
            closeMenu();
          }
        });
      }
    </script>
  </body>
</html>