---
const { title = "Jakuのサイト" ,description="Jakuの個人サイト"} = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/Jaku.svg" />
    <meta name="description" content={description} />
  </head>

  <body>
    <header>
       <div class="header-inner">
      <h1>Jakuのサイト</h1>

      <nav>
        <a href="/">ホーム</a>
        <a href="/blog">ブログ</a>
        <a href="/novel">小説</a>
        <a href="/characters">キャラクター</a>
        <a href="/links">リンク</a>
        <a href="/about">Jakuについて</a>
      </nav>
      <button id="theme-toggle">
        🌙
      </button>
      </div>
    </header>

<style is:global>
:root {
  --bg: #ffffff;
  --text: #111111;
  --accent: #0071e3;
  --border: #e5e5e5;
}
::selection {
  background: var(--accent);
  color: white;
}
:root.dark {
  --bg: #000000;
  --text: #f5f5f7;
  --accent: #2997ff;
  --border: #333333;
}
html {
  scroll-behavior: smooth;
}

body {
  margin: 0;

  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  background: var(--bg);
  color: var(--text);

  transition:
    background-color 0.3s ease,
    color 0.3s ease;
}

header {
  position: sticky;
  top: 0;

  z-index: 100;

  backdrop-filter: blur(30px);

  background: color-mix(
    in srgb,
    var(--bg) 70%,
    transparent
  );

  border-bottom: 1px solid
    color-mix(
      in srgb,
      var(--border) 50%,
      transparent
    );
}
.header-inner {
  max-width: 1100px;
  margin: 0 auto;
  padding: 24px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}
nav {
  display: flex;
  gap: 24px;
  margin-top: 12px;
  align-items: center;
}

nav a {
  text-decoration: none;
  color: var(--text);
}

#theme-toggle {
  border: 1px solid var(--border);

  border-radius: 999px;

  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: color-mix(
    in srgb,
    var(--bg) 90%,
    transparent
  );

  color: var(--text);

  font-size: 1.1rem;
  cursor: pointer;

  transition:
    transform 0.2s ease,
    opacity 0.2s ease;
}

#theme-toggle:hover {
  transform: scale(1.05);
}
main {
  max-width: 980px;
  margin: 0 auto;
  padding: 100px 24px;
}
h1 {
  margin: 0;
  font-size: 1.4rem;
}
a {
  color: inherit;
  text-decoration: none;

  transition:
    color 0.2s ease,
    opacity 0.2s ease;
}

a:hover {
  opacity: 0.8;
}
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(24px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.hero {
  text-align: center;
  animation: fadeUp 0.8s ease;

  position: relative;
  overflow: hidden;

  padding: 100px 0 140px;
}
.hero::before {
  content: "";

  position: absolute;

  width: 500px;
  height: 500px;

  border-radius: 50%;

  background:
    radial-gradient(
      rgba(0,113,227,.25),
      transparent
    );

  top: -150px;
  left: 50%;

  transform: translateX(-50%);

  z-index: -1;
}

.hero .button {
  margin: 12px;
}
.hero h2 {
  font-size: clamp(
    2.5rem,
    10vw,
    4rem
  );

  font-weight: 700;

  letter-spacing: -0.05em;

  margin-bottom: 16px;

  background:
    linear-gradient(
      180deg,
      var(--text),
      color-mix(
        in srgb,
        var(--text) 60%,
        transparent
      )
    );

  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.hero p {
  max-width: 700px;
  margin-left: auto;
  margin-right: auto;
}
.logo-circle {
  width: 180px;
  height: 180px;
  animation: float 4s ease-in-out infinite;
  margin: 0 auto 32px;
  border-radius: 50%;
  overflow: hidden; /* 追加 */

  background: linear-gradient(
    135deg,
    #0071e3,
    #6cb6ff
  );

  box-shadow:
    0 0 40px rgba(0,113,227,.3),
    0 0 80px rgba(0,113,227,.15);
}

.logo-circle img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

@keyframes float {
  0% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-10px);
  }

  100% {
    transform: translateY(0);
  }
}
.subtitle {
  font-size: 1.5rem;

  max-width: 650px;

  margin: 0 auto;

  opacity: .75;
}
.button {
  display: inline-block;
  padding: 12px 24px;

  border-radius: 999px;

  background: var(--accent);
  color: white;

  text-decoration: none;

  transition:
    transform 0.2s ease,
    opacity 0.2s ease;
}

.button:hover {
  transform: translateY(-2px);
  opacity: 0.9;
}
.cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;

  margin-top: 80px;
}

.card {
  padding: 24px;

  border-radius: 20px;

  text-decoration: none;
  color: var(--text);

  position: relative;
  overflow: hidden;

  border: 1px solid
    color-mix(
      in srgb,
      var(--border) 60%,
      transparent
    );

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,.03),
      rgba(255,255,255,.01)
    );

  backdrop-filter: blur(12px);

  box-shadow:
    0 4px 24px rgba(0,0,0,.08);

  transition:
    transform .3s ease,
    box-shadow .3s ease,
    border-color .3s ease;
}

.card:hover {
  transform: translateY(-10px);

  border-color: var(--accent);

  box-shadow:
    0 20px 50px rgba(0,0,0,.2);
}

.card::before {
  content: "";

  position: absolute;

  top: 0;
  left: -100%;

  width: 100%;
  height: 100%;

  background: linear-gradient(
    90deg,
    transparent,
    rgba(255,255,255,0.1),
    transparent
  );

  transition: left 0.6s ease;
}

.card:hover::before {
  left: 100%;
}
.card h3 {
  margin-top: 0;
}

.character-icon {
  width: 64px;
  height: 64px;

  border-radius: 50%;

  background: var(--accent);

  margin-bottom: 16px;
}
/* ===== 最新の更新 ===== */

.updates {
  margin-top: 100px;
}

.updates h2 {
  text-align: center;
  margin-bottom: 40px;
}

.update-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.update-item {
  padding: 20px;

  border: 1px solid var(--border);
  border-radius: 16px;

  background: color-mix(
    in srgb,
    var(--bg) 90%,
    transparent
  );
}

.date {
  display: block;

  margin-bottom: 8px;

  font-size: 0.9rem;
  opacity: 0.6;
}
article {
  max-width: 800px;
  margin: 0 auto;
  padding: 40px;

  border: 1px solid var(--border);
  border-radius: 24px;

  background: color-mix(
    in srgb,
    var(--bg) 92%,
    transparent
  );

  backdrop-filter: blur(12px);

  line-height: 1.9;
}

article h1 {
  font-size: 3rem;
  margin-bottom: 12px;
  line-height: 1.2;
}
article h2 {
  margin-top: 48px;
  margin-bottom: 16px;
  font-size: 1.8rem;
}
article p {
  margin-bottom: 20px;
}
article a {
  color: var(--accent);
  font-weight: 500;
}

article a:hover {
  text-decoration: underline;
}
article ul {
  padding-left: 24px;
  margin-bottom: 24px;
}

article li {
  margin-bottom: 8px;
}
.post-date {
  opacity: 0.6;
  margin-bottom: 32px;
}
footer {
  margin-top: 120px;
  padding: 40px 24px;
  opacity: 0.8;
  text-align: center;

  border-top: 1px solid var(--border);

  color: var(--text);
}

.footer-links {
  margin-top: 12px;

  display: flex;
  justify-content: center;
  gap: 20px;
}

.footer-links a {
  text-decoration: none;
  color: var(--text);

  opacity: 0.7;

  transition: opacity 0.2s ease;
}

.footer-links a:hover {
  opacity: 1;
}
@media (max-width: 768px) {

  .cards {
    grid-template-columns: 1fr;
  }

  .header-inner {
    flex-direction: column;
  }

  nav {
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero h2 {
    font-size: 3rem;
  }

}
</style>
    <main>
      <slot />
    </main>
<footer>
  <p>© 2026 Jaku / F5.SI</p>

  <div class="footer-links">
    <a href="/">ホーム</a>
    <a href="/about">About</a>
    <a href="/links">リンク</a>
  </div>
</footer>
  </body>
      <!-- ダークモードJS -->
    <script is:inline>
const button = document.getElementById("theme-toggle");

const savedTheme = localStorage.getItem("theme");

if (savedTheme === "dark") {
  document.documentElement.classList.add("dark");
  button.textContent = "☀️";
}

button.addEventListener("click", () => {
  document.documentElement.classList.toggle("dark");

  if (document.documentElement.classList.contains("dark")) {
    localStorage.setItem("theme", "dark");
    button.textContent = "☀️";
  } else {
    localStorage.setItem("theme", "light");
    button.textContent = "🌙";
  }
});
</script>
</html>