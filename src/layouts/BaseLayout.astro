---
const { title = "Jakuのサイト", description = "Jakuの個人サイト" } = Astro.props;
import SiteSearch from "../components/SiteSearch";
import "../styles/global.css";
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/characters/Jaku.svg" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="NWbNGyNv3Gs44SsLOsfA_FMj4IBu4SIdirn_51V7Rlc" />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QEGBZE58NB"></script>
    <meta name="google-site-verification" content="r8FqZ5bPy6yVhT83X9NhJVZqlMnSFE1VXcnrIpL5M-w" />
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-QEGBZE58NB');
    </script>
  </head>

  <body>
    <header>
      <div class="header-inner">
        <h1><a href="/">Jakuのサイト</a></h1>

        <nav id="site-nav" aria-label="メインメニュー">
          <a href="/">ホーム</a>
          <a href="/blog">開発ブログ</a>
          <a href="/blogs">日常ブログ</a>
          <a href="/farce">茶番</a>
          <a href="/characters">キャラクター</a>
          <a href="/links">リンク</a>
          <a href="/about">Jakuについて</a>
        </nav>
         <SiteSearch client:load />
          <div class="header-actions">
            <div class="header-account-wrap" id="header-account-wrap">
              <a
                href="/login"
                id="header-account-link"
                class="header-account-link"
                aria-label="Googleログイン"
              >
                ログイン
              </a>

              <div
                class="header-account-menu"
                id="header-account-menu"
                role="menu"
                aria-label="アカウントメニュー"
                hidden
              >
                <div class="header-account-menu-user">
                  <span id="header-account-name">ユーザー</span>
                  <span class="header-account-menu-label">ログイン中</span>
                </div>

                <div class="header-account-menu-divider"></div>

                <a
                  href="/account/settings/"
                  class="header-account-menu-item"
                  role="menuitem"
                  id="header-account-settings"
                >
                  <span>設定</span>
                </a>

                <button
                  type="button"
                  class="header-account-menu-item header-account-logout"
                  id="header-account-logout"
                  role="menuitem"
                >
                  ログアウト
                </button>
              </div>
            </div>

            <a
              href="/search/"
              class="header-search"
              aria-label="サイト内検索"
              title="サイト内検索"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-4-4"></path>
              </svg>
            </a>

            <button
              id="theme-toggle"
              type="button"
              aria-label="テーマを切り替える"
            >
              🌙
            </button>

            <button
              id="menu-toggle"
              class="menu-toggle"
              type="button"
              aria-label="メニューを開く"
              aria-controls="site-nav"
              aria-expanded="false"
            >
              <span></span>
              <span></span>
              <span></span>
            </button>
          </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

 
<footer class="site-footer">
  <div class="footer-inner">

    <!-- ブランド紹介 -->
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        Jakuのサイト<span>.</span>
      </a>

      <p class="footer-description">
        Jakuの興味・趣味・開発活動をまとめた個人サイト。
      </p>

      <p class="footer-brand-note">
        Code, Stories & Characters.
      </p>
    </div>

    <!-- EXPLORE -->
    <div class="footer-column">
      <h2>EXPLORE</h2>
      <p class="footer-heading-description">サイトメニュー</p>

      <nav aria-label="サイトメニュー">
        <a href="/">ホーム</a>
        <a href="/blog/">開発ブログ</a>
        <a href="/blogs/">日常ブログ</a>
        <a href="/farce/">茶番</a>
        <a href="/characters/">キャラクター</a>
      </nav>
    </div>

    <!-- ABOUT / ACCOUNT -->
    <div class="footer-column">
      <h2>ABOUT</h2>
      <p class="footer-heading-description">Jakuについて</p>

      <nav aria-label="Jakuについて">
        <a href="/about/">Jakuについて</a>
        <a href="/links/">リンク集</a>
      </nav>

      <h2 class="footer-subheading">ACCOUNT</h2>
      <p class="footer-heading-description">アカウント関連</p>

      <nav aria-label="アカウント">
        <a href="/login/">ログイン</a>
        <a href="/account/settings/">アカウント設定</a>
        <a href="/likes/">いいねした記事</a>
      </nav>
    </div>

    <!-- SUPPORT -->
    <div class="footer-column">
      <h2>SUPPORT</h2>
      <p class="footer-heading-description">サポート・お問い合わせ</p>

      <nav aria-label="サポート">
        <a href="/help/">ヘルプセンター</a>
        <a href="/contact/">お問い合わせ</a>
        <a href="/bug-report/">バグ報告</a>
      </nav>
    </div>

    <!-- LEGAL / FOLLOW -->
    <div class="footer-column">
      <h2>LEGAL</h2>
      <nav aria-label="規約">
        <a href="/terms/">利用規約</a>
        <a href="/privacy/">プライバシーポリシー</a>
      </nav>

      <h2 class="footer-subheading">FOLLOW ME</h2>
      <p class="footer-heading-description">外部サービス</p>

      <div class="footer-socials">
        <a
          class="footer-social-link"
          href="https://x.com/Jaku_1023"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X（旧Twitter）"
          title="X"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.59-6.64 7.59H.47l8.6-9.83L0 1.15h7.59l5.24 6.93zM17.61 20.64h2.04L6.49 3.24H4.3z" />
          </svg>
        </a>

        <a
          class="footer-social-link"
          href="https://www.youtube.com/@Jaku-1023"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="YouTubeチャンネル"
          title="YouTube"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z" />
          </svg>
        </a>

        <a
          class="footer-social-link"
          href="https://github.com/saijaku1"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHubプロフィール"
          title="GitHub"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 .8a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.16c-3.22.7-3.9-1.36-3.9-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.69 1.25 3.35.95.1-.74.4-1.25.73-1.54-2.57-.29-5.27-1.29-5.27-5.73 0-1.27.45-2.3 1.19-3.12-.12-.29-.52-1.47.11-3.07 0 0 .97-.31 3.16 1.19a10.97 10.97 0 0 1 5.75 0c2.19-1.5 3.15-1.19 3.15-1.19.63 1.6.24 2.78.12 3.07.74.82 1.19 1.85 1.19 3.12 0 4.45-2.71 5.43-5.29 5.72.42.36.78 1.06.78 2.14v3.2c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .8Z" />
          </svg>
        </a>
      </div>

      <p class="footer-social-description">
        X・YouTube・GitHubで活動中
      </p>
    </div>

  </div>

  <!-- 最下部 -->
  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} Jakuのサイト. All rights reserved.</p>
    <a href="#top" class="footer-top-link">
      トップページへ戻る ↑
    </a>
  </div>
</footer>

　　<script>
      import "../scripts/theme.js";
      import "../scripts/menu.js";
      import "../scripts/smooth-scroll.js";
      import "../scripts/header-auth.js";
　　</script>
  </body>
</html>