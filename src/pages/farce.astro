
---
import BaseLayout from "../layouts/BaseLayout.astro";
import farceEpisodes from "../data/farce.json";
import "../styles/farce-home.css";
---

<BaseLayout title="茶番">

  <section class="hero">
    <h2>茶番</h2>
    <p class="subtitle">
      Jakuたちの日常（？）
    </p>
  </section>

<section class="farce-list">
  {farceEpisodes.map((episode) => (
    <article class="card">
      <p class="episode-number">
        EPISODE {String(episode.episode).padStart(2, "0")}
      </p>

      <h3>{episode.title}</h3>

      <p>{episode.description}</p>

      <a
        href={`/farce/${episode.slug}/`}
        class="read-more"
      >
        第{episode.episode}話を読む →
      </a>
    </article>
  ))}
</section>

  <!-- ランダムに登場するキャラクター -->
  <div class="character-widget">
    <div class="character-message" role="status">
      やあ！ 茶番を読んでいく？
    </div>

    <img
      class="character-avatar"
      src="/characters/Jaku.svg"
      alt="Jaku"
      width="100"
      height="100"
    />
  </div>

  <script>
    import "../scripts/farce-widget.js";
  </script>

</BaseLayout>
