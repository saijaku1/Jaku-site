
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="茶番">

  <section class="hero">
    <h2>茶番</h2>
    <p class="subtitle">
      Jakuたちの日常（？）
    </p>
  </section>

  <section class="farce-list">
    <article class="card">
      <p class="episode-number">EPISODE 01</p>

      <h3>第1話：夏だ！</h3>

      <p>
        さあ、7月になったということで、いよいよ本格的な夏が始まった！！
        僕は、ビーチでぐったり中だけど
      </p>

      <a href="/farce/episode-1/" class="read-more">
        第1話を読む →
      </a>
    </article>
  </section>

  <!-- ランダムに登場するキャラクター -->
  <div class="character-widget">
    <div class="character-message" role="status">
      やあ！ 茶番を読んでいく？
    </div>

    <img
      class="character-avatar"
      src="/characters/Jaku.svg"
      alt="Jaku"
      width="100"
      height="100"
    />
  </div>

  <style>
    /* 茶番一覧 */
    .farce-list {
      max-width: 800px;
      margin: 40px auto;
    }

    .farce-list .card {
      padding: 24px;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--bg);
      transition:
        transform 0.3s ease,
        border-color 0.3s ease,
        box-shadow 0.3s ease;
    }

    .farce-list .card:hover {
      transform: translateY(-4px);
      border-color: var(--accent);
      box-shadow: 0 12px 32px rgba(0, 113, 227, 0.1);
    }

    .episode-number {
      color: var(--accent);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.08em;
    }

    .read-more {
      display: inline-block;
      margin-top: 12px;
      color: var(--accent);
      text-decoration: none;
      font-weight: 600;
    }

    .read-more:hover {
      text-decoration: underline;
    }

    /* キャラクターの共通設定 */
    .character-widget {
      position: fixed;
      z-index: 1000;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }

    /* 四隅への配置 */
    .character-widget.position-right-bottom {
      right: 24px;
      bottom: 20px;
    }

    .character-widget.position-left-bottom {
      left: 24px;
      bottom: 20px;
    }

    .character-widget.position-right-top {
      right: 24px;
      top: 100px;
    }

    .character-widget.position-left-top {
      left: 24px;
      top: 100px;
    }

    /* 丸いキャラクター画像 */
    .character-avatar {
      display: block;
      width: 100px;
      height: 100px;
      object-fit: contain;
      border-radius: 50%;
      cursor: pointer;
      transition: transform 0.25s ease;
    }

    .character-avatar:hover {
      transform: translateY(-5px) scale(1.05);
    }

    /* セリフの吹き出し */
    .character-message {
      max-width: 240px;
      padding: 12px 16px;
      border: 1px solid var(--border);
      border-radius: 18px;
      background: var(--bg);
      color: var(--text);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
      font-size: 0.9rem;
      line-height: 1.6;
      overflow-wrap: anywhere;

      opacity: 0;
      visibility: hidden;
      transform: translateY(8px);
      transition:
        opacity 0.25s ease,
        transform 0.25s ease,
        visibility 0.25s ease;
    }

    /* マウスを乗せると表示 */
    .character-widget:hover .character-message,
    .character-widget:focus-within .character-message {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    /* スマホ対応 */
    @media (max-width: 600px) {
      .character-widget.position-right-bottom {
        right: 12px;
        bottom: 12px;
      }

      .character-widget.position-left-bottom {
        left: 12px;
        bottom: 12px;
      }

      .character-widget.position-right-top {
        right: 12px;
        top: 80px;
      }

      .character-widget.position-left-top {
        left: 12px;
        top: 80px;
      }

      .character-avatar {
        width: 76px;
        height: 76px;
      }

      .character-message {
        max-width: min(200px, 65vw);
        font-size: 0.85rem;
      }
    }

    /* 動きを減らしたい設定への配慮 */
    @media (prefers-reduced-motion: reduce) {
      .character-avatar,
      .character-message,
      .farce-list .card {
        transition: none;
      }
    }
  </style>

  <script>
    // キャラクターごとの画像・セリフ
    const characters = [
      {
        name: "Jaku",
        image: "/characters/Jaku.svg",
        lines: [
          "よお。茶番はもう読んだかい？",
          "そこの君、僕の代わりにバイトを代行してくれないか？",
          "ねね。このサイト、どう思う？",
          "学校さぼりたいよぉ...",
          "このサイトはAstroっていうフレームワークで作られてるんだよ。",
          "タイピングが楽しすぎる！",
          "ちなみにココツとはもう3年ぐらいの付き合いなんだよね。",
          "ココツのことを知ってるのって多分僕が一番だと思うんだよね。だって僕のことを知ってるのはココツだけだし。(?)",
          "こういう些細な会話が楽しいんだよねぇ",
          "もしもこの世にアニメがなかったら....多分僕は生まれてなかった",
          "エルプサイ....コングルゥ....",
          "プログラミング....プログラミング....プログラミング....",
          "ちなみに僕はここ以外でもいろんなところで活動してるよ～",
        ],
      },
      {
        name: "ココツ",
        image: "/characters/kokotu.svg",
        lines: [
          "じゃくくんはおもろいよ。",
          "お、来てくれてありがとうねー",
          "勉強って本当に大変だよね。マジでわかる",
          "プログラミングと山登りって実は似てるんだよね。どっちも大変だけど、登りきったときの達成感が最高なんだよね。" ,
          "やっぱりホラーゲームは楽しいね。ジャンプスケアが最高だよね。",
          "僕は学生じゃないよ！かと言って犬じゃないからね！？",
        ],
      },
      {
        name: "ウサ",
        image: "/characters/usa.svg",
        lines: [
          "よろしくです！！",
          "今日も頑張るです！",
          "ふふふ……今日は私の出番です！",
          "じゃくは今なにやってるんでしょうね...",
          "これでもTypeScriptできるんですからね！？",
          "我が名はウサ！ウサギ族随一のプログラマーとして、TypeScriptの世界を書き開くもの！！！...あ、セリフ間違えちゃいました...",
          "本当にじゃくってひねくれてますよね...だけど私はそんなじゃくを尊敬してますけどね！",
          "そういえば最近アニメハマりました！！『この素晴らしい世界に祝福を！』ってやつめっちゃ面白いですね！"
        ],
      },
      {
        name: "うｐ主",
        image: "/characters/upunushi.svg",
        lines: [
          "気軽に話しかけてね...",
          "このサイトを作っているのはじゃくでアップロードをしたのが僕だよ",
          "僕はじゃくとココツたちの茶番を見守るだけの存在だよ",
          "はぁ...更新めんどくせぇ",
          "人生って山あり谷ありだよね",
          "Githubが誕生してなかったらどうなってたんだろうね..."
        ],
      },
      {
        name: "ミエ",
        image: "/characters/mie.svg",
        lines: [
          "やっほーー！！！！",
          "最近じゃくが変なことしてるって聞いたんだけどそれって本当！？",
          "ココツもウサもお姉ちゃんもみんな優しいなぁ～♪",
          "ぷろぐらみんぐってなぁに？",
          "ウサってウサギなんだね！？",
          "うｐ主はちょっと怖い...",
          "眠いよぉ....."
        ],
      },
      {
        name: "葵",
        image: "/characters/aoi.svg",
        lines: [
          "やっほ～",
          "実は私...じゃくに勝手に召喚されたんだよね...",
          "そういえばじゃくたちが話しているプログラミングって何なの？",
          "私もプログラミングを勉強してみようかな～",
          "実はこの羽さ、別に飛べるわけでもないのにさ。なんでついてるんだろうね",
          "最近じゃくが机叩いてる回数が多くて本当にうるさいんだけどさ、どうしたらいいんだろう..."
        ],
      },
    ];

    const positions = [
      "position-right-bottom",
      "position-left-bottom",
      "position-right-top",
      "position-left-top",
    ];

    const widget = document.querySelector(".character-widget");
    const avatar = document.querySelector(".character-avatar");
    const message = document.querySelector(".character-message");

    if (widget && avatar && message) {
      // 登場キャラクターをランダムに選ぶ
      const character =
        characters[Math.floor(Math.random() * characters.length)];

      // そのキャラクターのセリフをランダムに選ぶ
      const line =
        character.lines[Math.floor(Math.random() * character.lines.length)];

      // 配置をランダムに選ぶ
      const position =
        positions[Math.floor(Math.random() * positions.length)];

      avatar.src = character.image;
      avatar.alt = character.name;
      message.textContent = line;

      widget.classList.add(position);
    }
  </script>

</BaseLayout>
