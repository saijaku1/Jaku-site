---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="管理者ダッシュボード | Jaku">
  <main class="admin-page">
    <div id="admin-check" class="admin-check">
      <div class="spinner"></div>
      <p>管理者権限を確認しています...</p>
    </div>

    <section id="admin-content" hidden>
      <header class="admin-header">
        <div>
          <p class="admin-label">ADMINISTRATION</p>
          <h1>管理者ダッシュボード</h1>
          <p>Jakuのサイトを管理します。</p>
        </div>
        <span class="admin-badge">ADMIN</span>
      </header>

      <div class="admin-grid">
        <a href="/admin/blog/" class="admin-card">
          <span class="admin-icon">✎</span>
          <h2>ブログ管理</h2>
          <p>記事の追加・編集・削除</p>
        </a>

        <a href="/admin/news/" class="admin-card">
          <span class="admin-icon">▤</span>
          <h2>お知らせ管理</h2>
          <p>サイトのお知らせを管理</p>
        </a>

        <a href="/admin/farce/" class="admin-card">
          <span class="admin-icon">▣</span>
          <h2>茶番管理</h2>
          <p>エピソードやシーンを管理</p>
        </a>

        <a href="/admin/users/" class="admin-card">
          <span class="admin-icon">♙</span>
          <h2>ユーザー管理</h2>
          <p>登録ユーザーを確認</p>
        </a>

        <a href="/admin/likes/" class="admin-card">
          <span class="admin-icon">♡</span>
          <h2>いいね管理</h2>
          <p>いいねの状況を確認</p>
        </a>

        <a href="/admin/settings/" class="admin-card">
          <span class="admin-icon">⚙</span>
          <h2>システム設定</h2>
          <p>管理機能の設定</p>
        </a>
      </div>

      <p class="admin-notice">
        管理者専用エリアです。操作には十分注意してください。
      </p>
    </section>

    <p id="admin-error" class="admin-error" hidden>
      管理者権限を確認できませんでした。時間をおいて再度お試しください。
    </p>
  </main>

  <script>
    import { supabase } from "../../lib/supabase.js";

    const checkArea = document.querySelector("#admin-check");
    const adminContent = document.querySelector("#admin-content");
    const errorArea = document.querySelector("#admin-error");

    async function checkAdminAccess() {
      try {
        // ログイン状態を確認
        const { data: { session }, error: sessionError } =
          await supabase.auth.getSession();

        if (sessionError) throw sessionError;

        // ログインしていなければログインページへ
        if (!session) {
         window.location.replace("/login/?next=%2Fadmin%2F");
          return;
        }

        // Supabase側で管理者権限を確認
        const { data, error } = await supabase.rpc("is_admin");

        if (error) throw error;

        // 管理者でなければトップページへ
        if (data !== true) {
          window.location.replace("/");
          return;
        }

        // 管理者ならダッシュボードを表示
        checkArea.hidden = true;
        adminContent.hidden = false;

      } catch (error) {
        console.error("Admin authentication error:", error);

        checkArea.hidden = true;
        errorArea.hidden = false;
      }
    }

    checkAdminAccess();
  </script>

  <style>
    .admin-page {
      width: min(100% - 32px, 1100px);
      margin: 70px auto;
      min-height: 60vh;
    }

    .admin-check {
      display: grid;
      justify-items: center;
      gap: 16px;
      padding: 100px 20px;
      color: var(--text);
    }

    .spinner {
      width: 32px;
      height: 32px;
      border: 3px solid var(--border);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .admin-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 40px;
    }

    .admin-label {
      color: var(--accent);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 2px;
    }

    .admin-header h1 {
      margin: 8px 0;
      font-size: clamp(26px, 5vw, 38px);
    }

    .admin-header p {
      color: var(--text);
      opacity: 0.7;
    }

    .admin-badge {
      padding: 7px 13px;
      border: 1px solid var(--border);
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
    }

    .admin-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .admin-card {
      display: block;
      padding: 24px;
      color: var(--text);
      text-decoration: none;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 18px;
      transition: transform 0.2s, border-color 0.2s;
    }

    .admin-card:hover {
      transform: translateY(-4px);
      border-color: var(--accent);
    }

    .admin-icon {
      font-size: 28px;
    }

    .admin-card h2 {
      margin: 18px 0 8px;
      font-size: 17px;
    }

    .admin-card p {
      margin: 0;
      font-size: 13px;
      opacity: 0.65;
    }

    .admin-notice {
      margin-top: 30px;
      padding: 16px;
      border: 1px solid var(--border);
      border-radius: 12px;
      font-size: 13px;
      opacity: 0.7;
    }

    .admin-error {
      padding: 24px;
      border: 1px solid var(--border);
      border-radius: 12px;
      text-align: center;
    }
    .admin-check[hidden],
#admin-content[hidden],
.admin-error[hidden] {
  display: none !important;
}

    @media (max-width: 700px) {
      .admin-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .admin-page {
        margin: 40px auto;
      }
    }

    @media (max-width: 420px) {
      .admin-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .spinner {
        animation: none;
      }

      .admin-card {
        transition: none;
      }
    }
  </style>
</BaseLayout>
