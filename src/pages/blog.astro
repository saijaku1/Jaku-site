---
import BaseLayout from "../layouts/BaseLayout.astro";
import posts from "../data/blog.json";
---

<BaseLayout title="ブログ" description="気分で書くブログ">

  <section class="hero">
    <h2>ブログ</h2>

    <p class="subtitle">
      日常とかいろんなジャンルとかをブログにします！
    </p>
  </section>

  <section class="hero">
    <h2>開発日記</h2>

    <p class="subtitle">
      F5.SIの制作記録や学んだこと
    </p>
  </section>

  <section class="cards">
    {posts.map((post) => (
      <a href={`/blog/${post.slug}`} class="card">
        <h3>{post.title}</h3>
        <p>{post.description}</p>
        <small>{post.date}</small>
      </a>
    ))}
  </section>

</BaseLayout>