---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

console.log(posts);
---

<BaseLayout title="ブログ",description="気分で書くブログ">

    <section class="hero">
    <h2>ブログ</h2>

    <p class="subtitle">
     日常とかいろんなジャンルとかをブログにします！
    </p>
  </section>
<p>記事数: {posts.length}</p>
  <section class="cards">

  </section>
  <section class="hero">
    <h2>開発日記</h2>

    <p class="subtitle">
      F5.SIの制作記録や学んだこと
    </p>
  </section>

  <section class="cards">

    <a href="/blog/first-post" class="card">
      <h3>開発日記 #1</h3>
      <p>Astroを使ったサイト制作を開始しました。</p>
    </a>

    <a href="/blog/second-post" class="card">
      <h3>開発日記 #2</h3>
      <p>デザインやレイアウトを改善しました。</p>
    </a>

    <a href="/blog/third-post" class="card">
      <h3>開発日記 #3</h3>
      <p>ここまでの制作状況と今後の目標について。</p>
    </a>

  </section>

</BaseLayout>