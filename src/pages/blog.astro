
---
import BaseLayout from "../layouts/BaseLayout.astro";
import posts from "../data/blog.json";
---

<BaseLayout title="開発日記" description="Jakuのサイト制作やアップデートの開発記録">

  <section class="hero">
    <h2>開発日記</h2>
    <p class="subtitle">
      サイト制作やアップデートなどの開発記録です！！
    </p>
  </section>

  <section class="cards">
    {posts.map((post) => (
      <a href={`/blog/${post.slug}`} class="card">
        <h3>{post.title}</h3>
        <p>{post.description}</p>
        <small>{post.date}</small>
      </a>
    ))}
  </section>

</BaseLayout>
