
---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/login.css";
---

<BaseLayout title="ログイン" description="Jakuのサイトにログイン">
  <main class="login-page">
    <section class="login-card">
      <p class="eyebrow">ACCOUNT</p>
      <h1>ログイン</h1>

      <p class="description">
        Jakuのサイトにログインして、アカウント機能を利用できます。
      </p>

      <div id="auth-forms">
        <form id="login-form" class="auth-form">
          <div class="auth-field">
            <label for="login-email">メールアドレス</label>
            <input
              id="login-email"
              type="email"
              autocomplete="email"
              placeholder="example@example.com"
              required
            />
          </div>

          <div class="auth-field">
            <label for="login-password">パスワード</label>
            <input
              id="login-password"
              type="password"
              autocomplete="current-password"
              placeholder="パスワード"
              required
            />
          </div>

          <button class="primary-button" type="submit">
            ログイン
          </button>

          <button id="forgot-password" class="text-button" type="button">
            パスワードを忘れた場合
          </button>

          <p class="switch-text">
            アカウントをお持ちでない方は
            <button id="show-signup" class="text-button" type="button">
              新規登録
            </button>
          </p>

          <div class="help-link">
            <p>ヘルプが必要ですか?</p>
            <a href="/help/">ログインでお困りの場合はこちら</a>
          </div>
        </form>

        <form id="signup-form" class="auth-form" hidden>
          <div class="auth-field">
            <label for="signup-email">メールアドレス</label>
            <input
              id="signup-email"
              type="email"
              autocomplete="email"
              placeholder="example@example.com"
              required
            />
          </div>

          <div class="auth-field">
            <label for="signup-password">パスワード</label>
            <input
              id="signup-password"
              type="password"
              autocomplete="new-password"
              minlength="8"
              placeholder="8文字以上"
              required
            />
          </div>

          <div class="auth-field">
            <label for="signup-password-confirm">パスワード（確認）</label>
            <input
              id="signup-password-confirm"
              type="password"
              autocomplete="new-password"
              minlength="8"
              placeholder="もう一度入力"
              required
            />
          </div>

          <button class="primary-button" type="submit">
            アカウントを登録
          </button>

          <p class="switch-text">
            すでにアカウントをお持ちの方は
            <button id="show-login" class="text-button" type="button">
              ログイン
            </button>
          </p>

          <div class="help-link">
            <p>ヘルプが必要ですか?</p>
            <a href="/help/">新規登録でお困りの場合はこちら</a>
          </div>
        </form>

        <div class="separator">
          <span>または</span>
        </div>

        <button id="google-login" class="google-button" type="button">
          <span class="google-mark" aria-hidden="true">G</span>
          Googleでログイン
        </button>
      </div>

      <p
        id="login-status"
        class="login-status"
        role="status"
        aria-live="polite"
      ></p>

      
<section
  id="auth-error-details"
  class="auth-error"
  role="alert"
  aria-live="polite"
  hidden
>
  <div class="auth-error-heading">
    <strong id="auth-error-title">認証エラー</strong>
  </div>

  <p id="auth-error-reason"></p>

  <div class="auth-error-meta">
    <p>
      エラーコード：
      <code id="auth-error-code"></code>
    </p>

    <p>
      エラーID：
      <code id="auth-error-id"></code>
    </p>

    <p>
      発生日時：
      <time id="auth-error-time"></time>
    </p>
  </div>

  <p class="auth-error-help">
    問題が解決しない場合は、エラーIDを添えて<a href="/contact/" target="_blank" rel="noopener noreferrer">こちら</a>からお問い合わせください。
  </p>
</section>

      <section id="account-info" hidden>
        <p>ログイン中のアカウント</p>
        <p id="user-email"></p>
        <a href="/account/settings/" class="primary-button">
          アカウント設定
        </a>
        <button id="logout-button" type="button">
          ログアウト
        </button>
      </section>

      <a class="back-link" href="/">トップページに戻る</a>
    </section>
  </main>
</BaseLayout>

<script>
  import "../scripts/auth.js";
</script>
