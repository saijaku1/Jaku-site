---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/index.css";
import news from "../data/news.json";

const sortedNews = [...news].sort((a, b) =>
  b.date.localeCompare(a.date)
);

const latestNews = sortedNews.slice(0, 3);
---

<BaseLayout title="Jakuのサイト">

  <section class="hero">
    <div class="logo-circle">
      <img src="/characters/Jaku.svg" alt="Jaku">
    </div>

    <h2>Jakuのサイト</h2>

    <p class="subtitle">
      ようこそ！！
    </p>

    <p>
      ここではJakuの個人サイトです！気軽に見て行ってね！
    </p>

    <a href="/blog" class="button">
      ブログを見る
    </a>

    <a href="/farce" class="button">
      茶番を見る
    </a>
  </section>


<section class="cards home-cards">
  <a href="/blog" class="card home-card">
    <div class="home-card-content">
      <h3>ブログ</h3>
      <p>日記や技術記事を掲載しています。</p>
    </div>
    <span class="home-card-link">記事を読む <span aria-hidden="true">↗</span></span>
  </a>

  <a href="/farce" class="card home-card">
    <div class="home-card-content">
      <h3>茶番</h3>
      <p>Jakuたちの日常（？）を描いた茶番シリーズ。</p>
    </div>
    <span class="home-card-link">茶番を見る <span aria-hidden="true">↗</span></span>
  </a>

  <a href="/characters" class="card home-card">
    <div class="home-card-content">
      <h3>キャラクター</h3>
      <p>僕以外にもたくさんのキャラたちがいます！</p>
    </div>
    <span class="home-card-link">キャラクターを見る <span aria-hidden="true">↗</span></span>
  </a>
</section>


 
<section class="updates">
  <h2>最新の更新</h2>

  <div class="update-list">
    {latestNews.map((item) => (
      <article class="update-item">
        <time class="date" datetime={item.date}>
          {item.date}
        </time>

        {item.title && <h3>{item.title}</h3>}

        {item.version && <h3>{item.version}</h3>}

        {item.description && <p>{item.description}</p>}

        {item.details && (
          <ul>
            {item.details.map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
        )}

        {item.note && <h4>{item.note}</h4>}
      </article>
    ))}
  </div>

  <a class="updates-more" href="/news/">
    MORE <span aria-hidden="true">→</span>
  </a>
</section>


  <!-- 歴代のサイト -->
  <section class="site-history">
    <div class="history-heading">
      <p class="history-eyebrow">MY WEBSITE HISTORY</p>
      <h2>歴代のサイト</h2>
      <p>これまでに作ってきたサイトをまとめました。</p>
    </div>

    <div class="history-grid">

      <a
        class="history-card"
        href="https://mysite.f5.si"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="history-number">01</span>
        <div class="history-content">
          <span class="history-label">FIRST SITE</span>
          <h3>一代目(初代）公式サイト</h3>
          <p>初めてGithubやコーディングを使って作ったサイト。</p>
          <span class="history-link">サイトを見る ↗</span>
        </div>
      </a>

      <a
        class="history-card"
        href="https://saijaku.f5.si"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="history-number">02</span>
        <div class="history-content">
          <span class="history-label">SECOND SITE</span>
          <h3>二代目公式サイト</h3>
          <p>初代から改良を重ねたサイト。</p>
          <span class="history-link">サイトを見る ↗</span>
        </div>
      </a>

      <a
        class="history-card"
        href="https://sites.google.com/view/saijaku-site/ホーム"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="history-number">03</span>
        <div class="history-content">
          <span class="history-label">GOOGLE SITES</span>
          <h3>Googleサイト版公式サイト</h3>
          <p>初めてサイトに興味を持って作ったサイト。</p>
          <span class="history-link">サイトを見る ↗</span>
        </div>
      </a>

    </div>
  </section>
</BaseLayout>
