---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Characters">

  <section class="hero">
    <h2>Characters</h2>

    <p class="subtitle">
      創作キャラクター紹介
    </p>
  </section>

  <section class="cards">

    <div class="card">
        <div class="character-icon"></div>
      <h3>キャラクターA</h3>
      <p>
        主人公。明るく前向きな性格。
      </p>
    </div>

    <div class="card">
        <div class="character-icon"></div>
      <h3>キャラクターB</h3>
      <p>
        クールな相棒。
      </p>
    </div>

    <div class="card">
        <div class="character-icon"></div>
      <h3>キャラクターC</h3>
      <p>
        謎の多い人物。
      </p>
    </div>

  </section>

</BaseLayout>