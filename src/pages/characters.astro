
---
import BaseLayout from "../layouts/BaseLayout.astro";
import characters from "../data/characters.json";
import "../styles/character.css";
---

<BaseLayout title="Characters" description="Jakuのサイトに登場する6人のキャラクター紹介">

  <section class="character-hero">
    <span class="eyebrow">THE CHARACTERS</span>
    <h2>Characters<span class="title-dot">.</span></h2>
    <p class="subtitle">個性豊かな6人を紹介します。</p>
    <div class="hero-line"></div>
  </section>

  <section class="character-section" aria-label="キャラクター一覧">
    <div class="section-heading">
      <div>
        <span class="section-label">MEET THE CAST</span>
        <h3>登場キャラクター</h3>
      </div>
      <span class="character-count">06 CHARACTERS</span>
    </div>

   <div class="character-grid">
  {characters.map((character) => (
    <article class="character-card" data-reveal>
      <div class="character-visual">
        <span class="character-number">{character.number}</span>

        <div class="character-icon">
          <img
            src={character.image}
            alt={`${character.name}のキャラクター画像`}
            loading={character.number === "01" ? "eager" : "lazy"}
          />
        </div>
      </div>

      <div class="character-info">
        <span class="character-role">{character.role}</span>

        <h3>{character.name}</h3>

        <p class="character-description">{character.description}</p>

        <div class="character-divider"></div>

        <ul class="character-details">
          {character.details.map((detail) => (
            <li>
              <span>{detail.label}</span>
              <p>{detail.value}</p>
            </li>
          ))}
        </ul>

        <blockquote>「{character.quote}」</blockquote>
      </div>
    </article>
  ))}
</div>
</section>
  <script>
import "../scripts/character.js";
  </script>

</BaseLayout>
