---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/bug-report.css";
---

<BaseLayout
  title="バグ報告"
  description="Jakuのサイトで見つけた不具合を報告できます。"
>
  <section class="bug-page">
    <div class="bug-heading">
      <p class="eyebrow">BUG REPORT</p>
      <h2>不具合を報告する</h2>
      <p class="description">
        Jakuのサイトで見つけた不具合を教えてください。
        サイトの改善に役立てます！
      </p>
    </div>

    <form
      class="bug-form"
      action="https://formspree.io/f/xjygozgq"
      method="POST"
    >
      <label for="page">不具合が起きたページ</label>
      <input
        id="page"
        type="text"
        name="page"
        placeholder="例：茶番、キャラクター"
        required
      />

      <label for="category">不具合の種類</label>
      <select id="category" name="category" required>
        <option value="">選択してください</option>
        <option value="表示崩れ">表示崩れ</option>
        <option value="リンク切れ">リンク切れ</option>
        <option value="動作不良">動作不良</option>
        <option value="誤字・脱字">誤字・脱字</option>
        <option value="その他">その他</option>
      </select>

      <label for="details">不具合の詳しい内容</label>
      <textarea
        id="details"
        name="details"
        rows="6"
        placeholder="何が起きたのか、できるだけ詳しく教えてください。"
        required
      ></textarea>

      <label for="environment">端末・ブラウザ（任意）</label>
      <input
        id="environment"
        type="text"
        name="environment"
        placeholder="例：Windows / Chrome"
      />

      <button type="submit">バグを報告する →</button>

      <p class="form-note">
        送信内容はサイトの改善のために使用します。
        パスワードなどの個人情報は絶対に入力しないでください。
      </p>
    </form>
  </section>
</BaseLayout>
