
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="バグ報告"
  description="Jakuのサイトで見つけた不具合を報告できます。"
>
  <section class="bug-page">
    <div class="bug-heading">
      <p class="eyebrow">BUG REPORT</p>
      <h2>不具合を報告する</h2>
      <p class="description">
        Jakuのサイトで見つけた不具合を教えてください。
        サイトの改善に役立てます！
      </p>
    </div>

    <form
      class="bug-form"
      action="https://formspree.io/f/xjygozgq"
      method="POST"
    >
      <label for="page">不具合が起きたページ</label>
      <input
        id="page"
        type="text"
        name="page"
        placeholder="例：茶番、キャラクター"
        required
      />

      <label for="category">不具合の種類</label>
      <select id="category" name="category" required>
        <option value="">選択してください</option>
        <option value="表示崩れ">表示崩れ</option>
        <option value="リンク切れ">リンク切れ</option>
        <option value="動作不良">動作不良</option>
        <option value="誤字・脱字">誤字・脱字</option>
        <option value="その他">その他</option>
      </select>

      <label for="details">不具合の詳しい内容</label>
      <textarea
        id="details"
        name="details"
        rows="6"
        placeholder="何が起きたのか、できるだけ詳しく教えてください。"
        required
      ></textarea>

      <label for="environment">端末・ブラウザ（任意）</label>
      <input
        id="environment"
        type="text"
        name="environment"
        placeholder="例：Windows / Chrome"
      />

      <button type="submit">バグを報告する →</button>

      <p class="form-note">
        送信内容はサイトの改善のために使用します。
        パスワードなどの個人情報は入力しないでください。
      </p>
    </form>
  </section>
</BaseLayout>

<style>
  .bug-page {
    width: min(100% - 40px, 720px);
    margin: 64px auto 100px;
  }

  .bug-heading {
    margin-bottom: 36px;
    text-align: center;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .bug-heading h2 {
    margin: 12px 0;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.04em;
  }

  .description {
    line-height: 1.9;
    opacity: 0.75;
  }

  .bug-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 24px;
    background: var(--bg);
  }

  .bug-form label {
    margin-top: 12px;
    font-weight: 600;
  }

  .bug-form input,
  .bug-form select,
  .bug-form textarea {
    box-sizing: border-box;
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
    color: var(--text);
    font: inherit;
  }

  .bug-form textarea {
    resize: vertical;
    line-height: 1.8;
  }

  .bug-form input:focus,
  .bug-form select:focus,
  .bug-form textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .bug-form button {
    margin-top: 16px;
    padding: 15px 20px;
    border: none;
    border-radius: 14px;
    background: var(--accent);
    color: white;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .bug-form button:hover {
    opacity: 0.85;
  }

  .form-note {
    margin: 8px 0 0;
    font-size: 0.85rem;
    line-height: 1.8;
    opacity: 0.7;
  }

  @media (max-width: 600px) {
    .bug-page {
      margin-top: 40px;
      margin-bottom: 64px;
    }

    .bug-form {
      padding: 20px;
      border-radius: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bug-form button {
      transition: none;
    }
  }
</style>
