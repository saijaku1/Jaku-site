---
import "../../styles/callback.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="認証処理"
  description="Jakuのサイトの認証処理を行っています"
>
  <main class="callback-page">
    <section class="callback-card">
      <p class="eyebrow">ACCOUNT</p>

      <h1 id="callback-title">認証を確認しています...</h1>

      <p id="callback-status" role="status" aria-live="polite">
        しばらくお待ちください。
      </p>

      <!-- 認証エラー表示 -->
      <section
        id="auth-error-details"
        class="auth-error"
        role="alert"
        aria-live="assertive"
        hidden
      >
        <strong id="auth-error-title">認証エラー</strong>

        <p id="auth-error-reason"></p>

        <div class="auth-error-meta">
          <p>エラーコード：<code id="auth-error-code"></code></p>
          <p>エラーID：<code id="auth-error-id"></code></p>
          <p>発生日時：<time id="auth-error-time"></time></p>
        </div>

        <p class="auth-error-help">
          問題が解決しない場合は、エラーIDを添えてお問い合わせください。
        </p>
      </section>

      <!-- パスワード再設定フォーム -->
      <form id="recovery-form" hidden>
        <label for="new-password">新しいパスワード</label>
        <input
          id="new-password"
          type="password"
          minlength="8"
          autocomplete="new-password"
          placeholder="8文字以上"
          required
        />

        <label for="confirm-password">パスワード（確認）</label>
        <input
          id="confirm-password"
          type="password"
          minlength="8"
          autocomplete="new-password"
          placeholder="もう一度入力"
          required
        />

        <button id="recovery-submit" type="submit">
          パスワードを変更する
        </button>
      </form>

      <a id="callback-link" href="/" hidden>
        トップページへ戻る
      </a>
    </section>
  </main>
  <div id="callback-loading" class="callback-loading" role="status" aria-live="polite">
  <div class="callback-loading-card">
    <div class="loading-spinner"></div>
    <p>認証処理を行っています...</p>
    <span>しばらくお待ちください。</span>
  </div>
</div>
</BaseLayout>

<script>
  import { supabase } from "../../lib/supabase.js";

  // HTML要素
  const title = document.querySelector("#callback-title");
  const status = document.querySelector("#callback-status");
  const link = document.querySelector("#callback-link");

  const recoveryForm = document.querySelector("#recovery-form");
  const newPassword = document.querySelector("#new-password");
  const confirmPassword = document.querySelector("#confirm-password");
  const recoverySubmit = document.querySelector("#recovery-submit");

  // エラー表示用HTML
  const authErrorElement = document.querySelector("#auth-error-details");
  const authErrorTitle = document.querySelector("#auth-error-title");
  const authErrorReason = document.querySelector("#auth-error-reason");
  const authErrorCode = document.querySelector("#auth-error-code");
  const authErrorId = document.querySelector("#auth-error-id");
  const authErrorTime = document.querySelector("#auth-error-time");
  const callbackLoading = document.querySelector("#callback-loading");

  function hideCallbackLoading() {
    if (callbackLoading) {
      callbackLoading.hidden = true;
    }
  }
  // 独自エラーコード
  const AUTH_ERRORS = {
    otp_expired: {
      code: "AUTH-008",
      title: "認証リンクの有効期限が切れています",
      reason: "新しい確認メールを送信して、もう一度お試しください。",
    },

    weak_password: {
      code: "AUTH-004",
      title: "パスワードが弱すぎます",
      reason: "別のパスワードを設定してください。",
    },

    session_not_found: {
      code: "AUTH-009",
      title: "ログイン状態を確認できません",
      reason: "もう一度ログインしてください。",
    },

    refresh_token_not_found: {
      code: "AUTH-010",
      title: "ログイン情報を更新できません",
      reason: "もう一度ログインしてください。",
    },

    provider_disabled: {
      code: "AUTH-011",
      title: "ログイン方法を利用できません",
      reason: "現在、このログイン方法は無効になっています。",
    },

    access_denied: {
      code: "AUTH-012",
      title: "認証が拒否されました",
      reason: "認証を完了できませんでした。もう一度お試しください。",
    },
  };

  // エラーIDを生成
  function createAuthErrorId() {
    const bytes = crypto.getRandomValues(new Uint8Array(4));

    const hex = Array.from(bytes)
      .map((byte) => byte.toString(16).padStart(2, "0"))
      .join("")
      .toUpperCase();

    return `ERR-${hex}`;
  }

  // 認証エラーを表示
  function showAuthError(error) {
    // HTML要素の存在確認
    if (
      !authErrorElement ||
      !authErrorTitle ||
      !authErrorReason ||
      !authErrorCode ||
      !authErrorId ||
      !authErrorTime
    ) {
      console.error("認証エラー表示用HTMLが見つかりません。");
      return;
    }

    const supabaseCode = error?.code ?? "";

    let errorInfo = AUTH_ERRORS[supabaseCode];

    // エラーコードが一致しない場合、メッセージから判定
    const message = String(
      error?.message ?? error ?? ""
    ).toLowerCase();

    if (!errorInfo && message.includes("expired")) {
      errorInfo = AUTH_ERRORS.otp_expired;
    }

    if (!errorInfo && message.includes("access_denied")) {
      errorInfo = AUTH_ERRORS.access_denied;
    }

    // 対応するエラーがない場合
    if (!errorInfo) {
      errorInfo = {
        code: "AUTH-999",
        title: "認証に失敗しました",
        reason:
          "予期しないエラーが発生しました。時間をおいて再度お試しください。",
      };
    }

    const errorId = createAuthErrorId();
    const timestamp = new Date();

    // HTMLに表示
    authErrorTitle.textContent = errorInfo.title;
    authErrorReason.textContent = errorInfo.reason;
    authErrorCode.textContent = errorInfo.code;
    authErrorId.textContent = errorId;
    authErrorTime.textContent = timestamp.toLocaleString("ja-JP");

    authErrorElement.hidden = false;

    // 開発者向けログ
    console.error("[AUTH ERROR]", {
      customCode: errorInfo.code,
      errorId,
      supabaseCode,
      message: error?.message ?? String(error),
      timestamp: timestamp.toISOString(),
    });
  }

  // 認証コールバック処理
  async function handleCallback() {
    try {
      const url = new URL(window.location.href);

      const code = url.searchParams.get("code");

      const authError =
        url.searchParams.get("error_description") ||
        url.searchParams.get("error");

      if (authError) {
        throw new Error(authError);
      }

      if (code) {
        const { error } =
          await supabase.auth.exchangeCodeForSession(code);

        if (error) throw error;
      }

      const { data, error } = await supabase.auth.getSession();

      if (error) throw error;

      if (!data.session) {
        throw new Error("ログインセッションが見つかりません。");
      }

      // パスワード再設定の場合
      if (url.searchParams.get("type") === "recovery") {
        title.textContent = "新しいパスワードを設定";

        status.textContent =
          "新しく使用するパスワードを入力してください。";

        recoveryForm.hidden = false;
        return;
      }

      // 通常のGoogleログイン・メール確認
      title.textContent = "認証が完了しました！";
      status.textContent = "認証が正常に完了しました。";

      link.hidden = false;

      window.setTimeout(() => {
        window.location.replace("/");
      }, 1200);

    } catch (error) {
      title.textContent = "認証に失敗しました";

      status.textContent =
        "認証を完了できませんでした。詳細は以下をご確認ください。";

      showAuthError(error);
      hideCallbackLoading();
      link.hidden = false;
    }
  }

  // パスワード再設定
recoveryForm.addEventListener("submit", async (event) => {
  event.preventDefault();

  const password = newPassword.value;
  const confirm = confirmPassword.value;

  if (password.length < 8) {
    status.textContent = "パスワードは8文字以上にしてください。";
    return;
  }

  if (password !== confirm) {
    status.textContent = "パスワードが一致しません。";
    return;
  }

  recoverySubmit.disabled = true;
  status.textContent = "パスワードを変更しています...";

  if (callbackLoading) {
    callbackLoading.hidden = false;
  }

  try {
    const { error } = await supabase.auth.updateUser({
      password,
    });

    if (error) throw error;

    title.textContent = "変更が完了しました！";

    status.textContent =
      "パスワードを変更しました。新しいパスワードでログインできます。";

    recoveryForm.hidden = true;

    link.href = "/login";
    link.textContent = "ログインページへ";
    link.hidden = false;

  } catch (error) {
    status.textContent =
      "パスワードを変更できませんでした。詳細は以下をご確認ください。";

    showAuthError(error);

  } finally {
    recoverySubmit.disabled = false;
    hideCallbackLoading();
  }
});
  // コールバック開始
  void handleCallback();
</script>

<style>
  #recovery-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 24px;
    text-align: left;
  }

  #recovery-form[hidden] {
    display: none;
  }

  #recovery-form label {
    font-size: 14px;
    font-weight: 600;
  }

  #recovery-form input {
    box-sizing: border-box;
    width: 100%;
    min-height: 46px;
    padding: 10px 12px;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    font: inherit;
  }

  #recovery-form button {
    min-height: 46px;
    margin-top: 8px;
    color: white;
    background: var(--accent);
    border: 0;
    border-radius: 10px;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  #recovery-form button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  #callback-link[hidden] {
    display: none;
  }

  /* 認証エラー表示 */
  .auth-error {
    margin-top: 20px;
    padding: 18px;
    text-align: left;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .auth-error[hidden] {
    display: none;
  }

  .auth-error > strong {
    display: block;
    margin-bottom: 10px;
    color: #dc5555;
    font-size: 16px;
  }

  .auth-error p {
    overflow-wrap: anywhere;
  }

  .auth-error-meta {
    margin-top: 16px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    font-size: 13px;
  }

  .auth-error-meta code {
    overflow-wrap: anywhere;
  }

  .auth-error-help {
    margin-top: 12px;
    color: var(--text);
    opacity: 0.7;
    font-size: 12px;
  }
  /* 認証ローディング */
.callback-loading {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(8, 12, 24, 0.72);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.callback-loading[hidden] {
  display: none;
}

.callback-loading-card {
  width: min(320px, 100%);
  padding: 32px 24px;
  text-align: center;
  color: var(--text);
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 20px;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
}

.loading-spinner {
  width: 42px;
  height: 42px;
  margin: 0 auto 20px;
  border: 4px solid rgba(255, 255, 255, 0.18);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: callback-spin 0.8s linear infinite;
}

.callback-loading-card p {
  margin: 0;
  font-weight: 700;
  font-size: 16px;
}

.callback-loading-card span {
  display: block;
  margin-top: 8px;
  font-size: 12px;
  opacity: 0.65;
}

@keyframes callback-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .loading-spinner {
    animation-duration: 2s;
  }
}
</style>
