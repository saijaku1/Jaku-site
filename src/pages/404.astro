---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/404.css";
---
<BaseLayout title="404" description="お探しのページが見つかりませんでした。">

  <section class="hero error-page">

<div class="logo-circle" aria-hidden="true">
  <img src="/characters/404Jaku.svg" alt="Jaku">
</div>

<p class="error-label">PAGE NOT FOUND</p>

<h2 class="error-code">404</h2>

<p class="subtitle">
  ページが見つかりません
</p>

<p class="error-description">
  お探しのページは存在しないか、<br />
  移動された可能性があります。
</p>

<a href="/" class="button">
  ホームへ戻る
</a>

  </section>

</BaseLayout>