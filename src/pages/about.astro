---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About" description="JakuのプロフィールとWeb制作の歩み">
  <div class="about-page">

    <!-- Hero -->
    <section class="about-hero">
      <p class="eyebrow">ABOUT ME</p>

      <h2>
        はじめまして、<br />
        <span>Jakuです。</span>
      </h2>

      <p class="hero-description">
        Web制作とタイピングを楽しむ、高校1年生<br />
        学びながら、自分だけの場所を作っています。
      </p>

      <div class="hero-tags">
        <span>Web Development</span>
        <span>Creative</span>
        <span>Learning</span>
        <span>Typing</span>
      </div>

      <div class="hero-decoration" aria-hidden="true"></div>
    </section>

    <!-- Profile -->
    <section class="profile-section">
      <div class="section-heading">
        <p class="eyebrow">WHO I AM</p>
        <h2>Jakuについて。</h2>
        <p>好きなことを楽しみながら、少しずつ成長しています。</p>
      </div>

      <div class="profile-grid">

        <article class="profile-card intro-card">
          <span class="card-number">01 / PROFILE</span>
          <h3>自分の手で、<br />作ることが好き。</h3>
          <p>
            こんにちは、Jakuです。
            普段はタイピングやゲームをしたり
            Web制作やプログラミングを学びながら、
            自分の作品や日々の記録を発信しています。
          </p>
          <p>
            最近はAstroを使ったサイト制作に挑戦中。
            ただ動くものを作るだけでなく、
            デザインや使いやすさにもこだわっています。
          </p>
        </article>

        <article class="profile-card">
          <span class="card-number">02 / INTERESTS</span>
          <h3>好きなこと。</h3>
          <div class="interest-list">
            <div class="interest-item">
              <span class="interest-icon">⌘</span>
              <span>Web制作・プログラミング</span>
            </div>
            <div class="interest-item">
              <span class="interest-icon">⌨</span>
              <span>タイピング</span>
            </div>
            <div class="interest-item">
              <span class="interest-icon">🎮</span>
              <span>ゲーム・音ゲー（FNF）</span>
            </div>
            <div class="interest-item">
              <span class="interest-icon">♫</span>
              <span>アニメ・小説</span>
            </div>
          </div>
        </article>

        <article class="profile-card">
          <span class="card-number">03 / GOALS</span>
          <h3>これからの目標。</h3>
          <ul class="goal-list">
            <li>バイトとWeb制作を両立する</li>
            <li>サイトを継続して更新する</li>
            <li>新しい技術を学ぶ</li>
            <li>自分の作品を増やす</li>
            <li>タイピングの速度を上げる</li>
          </ul>
        </article>

        <article class="profile-card tech-card">
          <span class="card-number">04 / WORKSPACE</span>
          <h3>このサイトを作る技術。</h3>
          <p>
            HTML・CSS・JavaScriptを学びながら、
            Astroを中心にサイトを制作しています。
          </p>
          <div class="tech-list">
            <span>HTML</span>
            <span>CSS</span>
            <span>JavaScript</span>
            <span>Astro</span>
            <span>GitHub</span>
            <span>Vercel</span>
            <span>VS Code</span>
            <span>React</span>
          </div>
        </article>

      </div>
    </section>

    <!-- About this site -->
    <section class="site-section">
      <p class="eyebrow">THIS WEBSITE</p>
      <h2>ここは、Jakuの活動拠点。</h2>
      <p>
        ブログ、茶番など。
        好きなことや作ったものを、この場所に少しずつ積み重ねています。
      </p>
      <p>
        完成して終わりではなく、更新するたびに成長していく。
        そんなサイトを目指しています。
      </p>
      <a class="text-link" href="/">サイトのトップへ <span>↗</span></a>
    </section>

    <!-- Timeline -->
    <section class="story-section">
      <div class="section-heading">
        <p class="eyebrow">MY STORY</p>
        <h2>ここまでの歩み。</h2>
        <p>小さな一歩から、今のWeb制作へ。</p>
      </div>

      <div class="timeline">
        <article class="timeline-item">
          <div class="timeline-year">2026</div>
          <div class="timeline-content">
            <span class="timeline-label">THIRD WEBSITE</span>
            <h3>3代目公式サイトを公開</h3>
            <p>
              初代サイトと2代目の反省点をさらに活かし、
              さらに機能と需要性を高めたサイトを制作。
              これからも、少しずつ更新していきます。
            </p>
          </div>
        </article>

        <article class="timeline-item">
          <div class="timeline-year">2025</div>
          <div class="timeline-content">
            <span class="timeline-label">SECOND WEBSITE</span>
            <h3>2代目公式サイトを公開</h3>
            <p>
              初代サイトの反省点を活かし、
              より見やすく使いやすいサイトを目指して制作。
              経験を重ねる一方で、改善したい点も見えてきました。
            </p>
          </div>
        </article>

        <article class="timeline-item">
          <div class="timeline-year">2024</div>
          <div class="timeline-content">
            <span class="timeline-label">FIRST WEBSITE</span>
            <h3>初代公式サイトを公開</h3>
            <p>
              初めて自分の公式サイトを制作。
              GitHubなどのツールやデザインには課題もありましたが、
              自分のサイトを作る楽しさを知る大切な経験になりました。
            </p>
          </div>
        </article>

        <article class="timeline-item">
          <div class="timeline-year">2022</div>
          <div class="timeline-content">
            <span class="timeline-label">WEB DEVELOPMENT</span>
            <h3>Web制作を本格的に学ぶ</h3>
            <p>
              HTML・CSS・JavaScriptを学び始め、
              ビジュアルプログラミングから
              コードを書くプログラミングへと挑戦を広げました。
            </p>
          </div>
        </article>

        <article class="timeline-item">
          <div class="timeline-year">2020</div>
          <div class="timeline-content">
            <span class="timeline-label">THE BEGINNING</span>
            <h3>プログラミングとの出会い</h3>
            <p>
              ScratchやQUREOなどに触れ、
              プログラミングへの最初の一歩を踏み出しました。
              ここから少しずつ、今につながる経験が始まりました。
            </p>
          </div>
        </article>

      </div>
    </section>

    <!-- Closing -->
    <section class="closing-section">
      <p class="eyebrow">STILL IN PROGRESS</p>
      <h2>これからも、少しずつ。</h2>
      <p>
        このサイトも、自分自身も、まだ成長の途中。<br />
        これからの更新も、ぜひ見守ってください。
      </p>
      <a class="closing-link" href="/blog">開発記録を読む <span>→</span></a>
    </section>

  </div>

  <style>
    .about-page {
      --about-blue: var(--accent, #0071e3);
      --about-muted: #86868b;
      padding-bottom: 40px;
    }

    .about-page p {
      line-height: 1.9;
    }

    .eyebrow {
      color: var(--about-blue);
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      margin: 0 0 16px;
    }

    /* Hero */
    .about-hero {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      padding: 100px 24px 90px;
      text-align: center;
      border-bottom: 1px solid var(--border);
    }

    .about-hero h2 {
      position: relative;
      z-index: 1;
      margin: 0;
      font-size: clamp(2.7rem, 7vw, 5.3rem);
      font-weight: 750;
      letter-spacing: -0.065em;
      line-height: 1.18;
    }

    .about-hero h2 span {
      color: var(--about-blue);
    }

    .hero-description {
      position: relative;
      z-index: 1;
      margin: 28px auto 0;
      color: var(--about-muted);
      font-size: 1rem;
    }

    .hero-tags {
      position: relative;
      z-index: 1;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 28px;
    }

    .hero-tags span,
    .tech-list span {
      padding: 8px 13px;
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 0.78rem;
    }

    .hero-decoration {
      position: absolute;
      z-index: -1;
      top: 12%;
      left: 50%;
      width: min(65vw, 600px);
      aspect-ratio: 1;
      transform: translateX(-50%);
      border-radius: 50%;
      background: radial-gradient(
        circle,
        color-mix(in srgb, var(--about-blue) 16%, transparent),
        transparent 70%
      );
      filter: blur(20px);
      pointer-events: none;
    }

    /* Section headings */
    .profile-section,
    .story-section {
      padding: 90px 0 0;
    }

    .section-heading {
      margin: 0 auto 36px;
      text-align: center;
    }

    .section-heading h2,
    .site-section h2,
    .closing-section h2 {
      margin: 0;
      font-size: clamp(1.8rem, 4vw, 2.7rem);
      letter-spacing: -0.045em;
      line-height: 1.35;
    }

    .section-heading > p:last-child {
      margin: 14px 16px 0;
      color: var(--about-muted);
      font-size: 0.9rem;
    }

    /* Profile cards */
    .profile-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .profile-card {
      min-width: 0;
      box-sizing: border-box;
      padding: 30px;
      border: 1px solid var(--border);
      border-radius: 24px;
      background: var(--card-bg, var(--bg));
      transition:
        transform 0.25s ease,
        border-color 0.25s ease;
    }

    .profile-card:hover {
      transform: translateY(-4px);
      border-color: var(--about-blue);
    }

    .intro-card {
      display: flex;
      flex-direction: column;
      justify-content: center;
      background:
        linear-gradient(
          145deg,
          color-mix(in srgb, var(--about-blue) 9%, var(--bg)),
          var(--bg) 75%
        );
    }

    .card-number {
      color: var(--about-muted);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.12em;
    }

    .profile-card h3 {
      margin: 22px 0 14px;
      font-size: 1.35rem;
      letter-spacing: -0.035em;
      line-height: 1.5;
    }

    .profile-card p {
      margin: 0 0 14px;
      font-size: 0.9rem;
      color: var(--about-muted);
    }

    .profile-card p:last-child {
      margin-bottom: 0;
    }

    .interest-list {
      display: grid;
      gap: 12px;
      margin-top: 20px;
    }

    .interest-item {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 0.88rem;
    }

    .interest-icon {
      display: grid;
      place-items: center;
      flex-shrink: 0;
      width: 36px;
      height: 36px;
      border-radius: 12px;
      color: var(--about-blue);
      background: color-mix(
        in srgb,
        var(--about-blue) 10%,
        transparent
      );
      font-size: 1rem;
    }

    .goal-list {
      display: grid;
      gap: 12px;
      margin: 18px 0 0;
      padding-left: 20px;
      font-size: 0.88rem;
      line-height: 1.8;
    }

    .goal-list li::marker {
      color: var(--about-blue);
    }

    .tech-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 20px;
    }

    .tech-list span {
      font-weight: 600;
    }

    /* Website description */
    .site-section {
      margin-top: 90px;
      padding: 52px 40px;
      border: 1px solid var(--border);
      border-radius: 28px;
      background: color-mix(
        in srgb,
        var(--border) 18%,
        var(--bg)
      );
    }

    .site-section h2 {
      max-width: 650px;
    }

    .site-section > p:not(.eyebrow) {
      max-width: 650px;
      color: var(--about-muted);
      font-size: 0.93rem;
    }

    .text-link,
    .closing-link {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-top: 12px;
      color: var(--about-blue);
      font-weight: 650;
      text-decoration: none;
    }

    .text-link span,
    .closing-link span {
      transition: transform 0.2s ease;
    }

    .text-link:hover span,
    .closing-link:hover span {
      transform: translateX(4px);
    }

    /* Timeline */
    .timeline {
      position: relative;
      max-width: 820px;
      margin: 48px auto 0;
    }

    /* タイムラインの縦線 */
    .timeline::after {
      content: "";
      position: absolute;
      top: 8px;
      bottom: 8px;
      left: 89px; /* 年表示（80px）＋ギャップ・調整分の中央に配置 */
      width: 2px;
      background: var(--accent);
      transform: scaleY(var(--timeline-scale, 0));
      transform-origin: top;
      transition: transform 0.1s linear;
      pointer-events: none;
    }

    .timeline-item {
      position: relative;
      display: grid;
      grid-template-columns: 80px minmax(0, 1fr);
      column-gap: 48px;
      margin-bottom: 28px;
    }

    .timeline-year {
      padding-top: 24px;
      color: var(--accent);
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: -0.05em;
      text-align: right;
      transition: color 0.3s ease, transform 0.3s ease;
    }

    .timeline-content {
      position: relative;
      min-width: 0;
      padding: 24px 28px;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--bg);
    }

    /* タイムラインのドット */
    .timeline-item::before {
      content: "";
      position: absolute;
      top: 32px;
      left: 85px; /* 縦線の中心に合わせるよう微調整 */
      width: 10px;
      height: 10px;
      box-sizing: border-box;
      border-radius: 50%;
      background: var(--accent);
      border: 2px solid var(--bg);
      box-shadow: 0 0 0 1px var(--accent);
      z-index: 2;
    }

    /* スクロールで選択された項目 */
    .timeline-item.is-active .timeline-year {
      color: var(--accent);
      transform: scale(1.05);
    }

    .timeline-item.is-active .timeline-content {
      border-color: var(--accent);
    }

    .timeline-item.is-active::before {
      background: var(--accent);
      box-shadow: 0 0 0 5px rgb(0 113 227 / 15%);
      transform: scale(1.15);
    }

    @media (prefers-reduced-motion: reduce) {
      .timeline-year,
      .timeline-content,
      .timeline-item::before {
        transition: none;
      }
    }

    .timeline-label {
      color: #86868b;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.1em;
    }

    .timeline-content h3 {
      margin: 10px 0;
      font-size: 1.15rem;
    }

    .timeline-content p {
      margin: 0;
      color: var(--text);
      opacity: 0.75;
      font-size: 0.9rem;
      line-height: 1.9;
    }

    @media (max-width: 768px) {
      /* プロフィールカードを1列に */
      .profile-grid {
        grid-template-columns: minmax(0, 1fr);
      }

      /* タイムラインをスマホ用レイアウトに変更 */
      .timeline {
        margin-top: 36px;
      }

      .timeline::after {
        left: 5px;
      }

      .timeline-item {
        grid-template-columns: minmax(0, 1fr);
        gap: 10px;
        padding-left: 20px;
        margin-bottom: 28px;
      }

      .timeline-year {
        padding-top: 0;
        text-align: left;
        font-size: 1.2rem;
      }

      .timeline-content {
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
        padding: 20px;
      }

      .timeline-item::before {
        top: 5px;
        left: 0;
      }

      .cards {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  </style>
  
  <script>
    const timelineItems = document.querySelectorAll(".timeline-item");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            timelineItems.forEach((item) => {
              item.classList.remove("is-active");
            });

            entry.target.classList.add("is-active");
          }
        });
      },
      {
        rootMargin: "-35% 0px -45% 0px",
        threshold: 0,
      }
    );

    timelineItems.forEach((item) => observer.observe(item));

    const timeline = document.querySelector(".timeline");

    if (timeline) {
      let ticking = false;

      const updateTimeline = () => {
        const rect = timeline.getBoundingClientRect();
        const start = window.innerHeight * 0.65;
        const distance = rect.height - start;
        const progress = distance > 0
          ? Math.max(0, Math.min(1, (start - rect.top) / distance))
          : 0;

        timeline.style.setProperty("--timeline-progress", String(progress));
        timeline.style.setProperty("--timeline-scale", String(progress));

        ticking = false;
      };

      const onScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(updateTimeline);
          ticking = true;
        }
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", updateTimeline);
      updateTimeline();
    }
  </script>
</BaseLayout>