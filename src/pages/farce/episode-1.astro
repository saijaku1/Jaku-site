---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/farce.css';

const scenes = [
  { speaker: 'jaku', text: 'というわけで、茶番完成……ということでいいのかな？' },
  { speaker: 'kokotu', text: 'うう……まさか僕たちの会話、全部「茶番」として処理されてたなんて……。' },
  { speaker: 'kokotu', text: 'ねえ、とりあえずさ……このなんとも言えない気まずい空気、どうにかしない！？' },
  { speaker: 'upunushi', text: 'うおーーーー！ 暇だーーーー！' },
  { speaker: 'kokotu', text: 'おい、うp主。少しは空気を読みなさい。' },
  { speaker: 'upunushi', text: 'あ、すみません。' },
  { speaker: 'jaku', text: 'ま、気を取り直して切り替えよう！ あ,そういえば僕,この前ビーチに行ってきたんだよね！（強引な話題転換）' },
  { speaker: 'upunushi', text: 'おおーーー！！！ まじで！？ 写真見せて！' },
  { image: 'natujaku.webp', alt: 'ビーチにいる夏のJaku' },
  { speaker: 'upunushi', text: '……ねえ、なんでAI生成なの？ しかもこれ,じゃくっていうかほぼシロクマだし。砂浜でノートPC叩いてる奴初めて見たんだけど……ツッコミどころ多すぎない？' },
  { speaker: 'jaku', text: '一言余計なんだよ！ 仕方ないだろ！ うっかり写真を撮り忘れたんだから！！' },
  { speaker: 'upunushi', text: 'いや,撮り忘れたからってAIで捏造するのはどうなの……。' },
  { speaker: 'jaku', text: 'いいじゃん別に！！ 雰囲気は伝わったでしょ！？ 撮り忘れたのは認めるけどさ！！' },
  { speaker: 'kokotu', text: 'はいはい二人とも,喧嘩はやめなよ～？ これ一応「茶番」なんだから,みんなに見られてるよ～～？' },
  { speaker: 'upunushi', text: '……観てくださっている皆さん,見苦しいところをお見せしてすみません。' },
  { speaker: 'jaku', text: '……むぅ。（不服そうに黙る）' },
  { speaker: 'kokotu', text: 'ところでさ,もうすぐ夏休みだけど二人は何するの？ ちなみに僕は予定ゼロで暇だけど。' },
  { speaker: 'jaku', text: '出たな引きこもり！ 予定のない奴は黙ってなさい！' },
  { speaker: 'kokotu', text: '引きこもりじゃないし！ 僕は君と違って学生じゃないの！！！！ 証拠に僕の夏の思い出を見せてあげるよ！' },
  { note: 'ココツが写真を見せる。' },
  { image: 'kokotunatu.webp', alt: '夏のココツ' },
  { speaker: 'jaku', text: 'うわ出た！！ 室内で完結してるタイプの陰キャ！！ チー牛確定おつかれさまでーすｗｗｗ' },
  { speaker: 'kokotu', text: '……見損なったよ,じゃく。' },
  { speaker: 'jaku', text: 'え,なにその急な真面目モード？' },
  { speaker: 'kokotu', text: 'うp主さん。こいつを「削除」して。' },
  { note: 'ココツ,完全にブチ切れ……。' },
  { speaker: 'jaku', text: 'ん？ 削除ぉ？ できるもんならやってみなよ～？（調子に乗っている）' },
  { speaker: 'upunushi', text: 'あ,じゃく。調子に乗る前に過去のログ見てみな。' },
  { image: 'kaiwa.webp', alt: '過去の会話' },
  { speaker: 'jaku', text: '……あ。（急激に青ざめる）' },
  { speaker: 'kokotu', text: 'ちなみに,前回の僕はこんな感じだったよ。' },
  { image: 'bousou.webp', alt: '暴走するココツ' },
  { speaker: 'upunushi', text: 'おーい,じゃくー？ 生きてるかー？ 安心しろ,まだ消すボタンは押してないから。' },
  { image: 'zetuboujaku.webp', alt: '絶望したJaku' },
  { note: '絶望のあまり,グラフィックのデータまでバグり始めてしまった。' },
  { speaker: 'jaku', text: 'いやぁぁぁぁぁ！！ やめてぇぇぇ！！ 僕のデータを消さないでぇ！！' },
  { image: 'delete.webp', alt: 'Jakuが消される場面' },
  { speaker: 'upunushi', text: 'あ,手が滑って消しちゃった★' },
  { speaker: 'kokotu', text: 'え,あ……本当に消されちゃったの……？' },
  { speaker: 'jaku', text: 'ふふふ……甘いな！ 僕がこの程度で消滅すると思ったか！？' },
  { speaker: 'kokotu', text: '！？ な,なんで普通に復活してるの！？' },
  { speaker: 'jaku', text: 'フッ……勝ち誇るには早いな！ バックアップなら常に取ってあるのだ！！（満面のドヤ顔）' },
  { speaker: 'upunushi', text: 'あ,それ僕がプロジェクトに設定しておいたオートリカバリー機能だわ。' },
  { speaker: 'jaku', text: 'おいバラすなよ！！ ここは僕の技術力ってことにしとけよ！！' },
  { speaker: 'kokotu', text: 'ふふ,まあでも……無事に戻ってきてくれたのは,ちょっと良かったかも。また茶番続けられるしね。' },
  { speaker: 'jaku', text: '……ん？ ココツ,もしかして君……ツンデレなの？' },
  { speaker: 'kokotu', text: 'えっ……/// べ,別にそんなんじゃ……うん……（隠しきれない素直さ）' },
  { speaker: 'upunushi', text: 'ココツ……素直でかわいい……。' },
  { speaker: 'kokotu', text: 'ちょっと二人とも！！ からかわないでよ！！！！ ……////' },
  { speaker: 'upunushi', text: 'はぁ……そろそろ尺的にも茶番終わりそうだけどさ。' },
  { speaker: 'kokotu', text: '……というかさ,今更だけど僕たちって結局どういう存在なんだろうね？' },
  { speaker: 'jaku', text: '考えるな,感じろ！！ 細かい設定はノリでカバーだ！！' },
  { speaker: 'kokotu', text: 'またそうやって適当にごまかす……。' },
  { speaker: 'upunushi', text: 'はぁ……なんかもう,台本書いて画像作って編集するの疲れてきたんだけど……。' },
  { speaker: 'jaku', text: 'え,茶番の編集ってそんなに大変なの？' },
  { speaker: 'upunushi', text: '当たり前だろ！ セリフ考えて,テンポ調整して,画像配置して……めちゃくちゃ時間かかるんだぞ！' },
  { speaker: 'jaku', text: 'う,うむ……ごめんって……って待て！ 「セリフを考える」！？ 僕らをただのスクリプト扱いする気か！ 意志ある存在だぞ！！ このサイコパス主め！' },
  { speaker: 'kokotu', text: '……でもさ,こうやって形になると,ちょっとした達成感はあるよね。' },
  { speaker: 'jaku', text: 'まあね！ それはちょっと分かるかも！' },
  { speaker: 'upunushi', text: '……。で,苦労して作って,なんで僕はこれをネットに投稿してるんだろう……。' },
  { speaker: 'jaku', text: 'おいおい……急に深刻な賢者タイムに入るなよ,うp主……！' },
  { system: 'System Message: うp主 has just logged out.（システムメッセージ：うp主がログアウトしました）' },
  { speaker: 'kokotu', text: '……あ,耐えかねてログアウトしちゃった。' },
  { speaker: 'kokotu', text: 'まあいっか！ というわけで皆さん,ここまでお付き合いいただきありがとうございました！ また次回お会いしましょう～！' },
  { speaker: 'jaku', text: '結局僕らってなんだろうね...' }
  
];

---

<BaseLayout title="【第一話】 夏だ！！" description="Jakuたちの茶番、第1話！">

  <main class="episode">
    <header class="episode-header">
      <p class="episode-label">JAKU'S FARCE / EPISODE 01</p>
      <h1>【第一話】 夏だ！！</h1>
      <p class="episode-description">※これは二代目の公式サイトの茶番を新編集した茶番です。</p>
      <h2 class="episode-description">Jakuたちの、ちょっとおかしな夏の物語。</h2>
    </header>

    <section class="story" aria-label="第一話の本編">
      {scenes.map((scene) => (
        scene.image ? (
          <figure class="scene-image">
            <img
              src={`/farce/episode-1/${scene.image}`}
              alt={scene.alt ?? ''}
              loading="lazy"
            />
          </figure>
        ) : scene.note ? (
          <p class="scene-note">{scene.note}</p>
        ) : scene.system ? (
          <h2 class="system-message">{scene.system}</h2>
        ) : (
          <article class:list={['talk', scene.speaker]}>
            <img
              class="avatar"
              src={
                scene.speaker === 'jaku'
                  ? '/characters/Jaku.svg'
                  : scene.speaker === 'kokotu'
                    ? '/characters/kokotu.svg'
                    : '/characters/upunushi.svg'
              }
              alt={
                scene.speaker === 'jaku'
                  ? 'Jaku'
                  : scene.speaker === 'kokotu'
                    ? 'ココツ'
                    : 'うp主'
              }
              loading="lazy"
            />
            <p class="speech">{scene.text}</p>
          </article>
        )
      ))}
    </section>

    <section class="next-preview">
      <p class="preview-label">NEXT EPISODE</p>
      <h2>次回！</h2>
      <p>第二話「編集大変！」</p>
    </section>

    <nav class="episode-navigation" aria-label="エピソード移動">
      <a href="/farce/">茶番一覧へ戻る</a>
      <a href="/farce/episode-2">次の話を見る →</a>
    </nav>
  </main>
  <script>
  import '../../scripts/farce.js';
</script>
</BaseLayout>

