
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="いいねした記事"
  description="自分がいいねしたブログ記事の一覧"
>
  <main class="likes-page">

    <a href="/account/settings/" class="back-link">
      ← アカウント設定に戻る
    </a>

    <section class="hero">
      <h2>いいねした記事</h2>
      <p class="subtitle">
        気に入った記事を、ここからいつでも見返せます。
      </p>
    </section>

    <div
      id="likes-status"
      class="status"
      role="status"
      aria-live="polite"
    >
      いいね履歴を読み込んでいます...
    </div>

    <section id="likes-list" class="cards"></section>

  </main>

  <script>
    import { supabase } from "../lib/supabase.js";
    import developmentPosts from "../data/blog.json";
    import dailyPosts from "../data/blogs.json";

    const status = document.querySelector("#likes-status");
    const list = document.querySelector("#likes-list");

    function showStatus(message) {
      if (status) {
        status.textContent = message;
      }
    }

    function clearList() {
      list?.replaceChildren();
    }

    // 2種類の記事を統合
    const allPosts = [
      ...developmentPosts.map((post) => ({
        ...post,
        likeSlug: post.slug,
        href: `/blog/${encodeURIComponent(post.slug)}/`,
        category: post.category || "開発日記",
      })),

      ...dailyPosts.map((post) => ({
        ...post,
        likeSlug: `daily-${post.slug}`,
        href: `/blogs/${encodeURIComponent(post.slug)}/`,
        category: post.category || "日常",
      })),
    ];

    // いいね識別子から記事を検索できるようにする
    const postsBySlug = new Map(
      allPosts.map((post) => [post.likeSlug, post])
    );

    // 読み込みの重複・競合を防止
    let loadRequestId = 0;

    async function loadLikes() {
      const currentRequestId = ++loadRequestId;

      clearList();
      showStatus("いいね履歴を読み込んでいます...");

      // ログイン状態を確認
      const {
        data: sessionData,
        error: sessionError,
      } = await supabase.auth.getSession();

      if (currentRequestId !== loadRequestId) return;

      if (sessionError) {
        console.error(sessionError);
        showStatus("ログイン状態を確認できませんでした。");
        return;
      }

      const user = sessionData.session?.user;

      // 未ログインの場合
      if (!user) {
        showStatus("いいね履歴を見るにはログインしてください。");

        const loginLink = document.createElement("a");
        loginLink.href = "/login";
        loginLink.className = "login-link";
        loginLink.textContent = "ログインする";

        list?.append(loginLink);
        return;
      }

      // Supabaseからいいね履歴を取得
      const {
        data: likes,
        error,
      } = await supabase
        .from("likes")
        .select("post_slug, created_at")
        .eq("user_id", user.id)
        .order("created_at", { ascending: false });

      if (currentRequestId !== loadRequestId) return;

      if (error) {
        console.error(error);
        showStatus("履歴を取得できませんでした。");
        return;
      }

      // 同じ記事の重複を除去
      const uniqueLikes = [
        ...new Map(
          (likes ?? []).map((like) => [like.post_slug, like])
        ).values(),
      ];

      if (uniqueLikes.length === 0) {
        showStatus("まだいいねした記事はありません。");
        return;
      }

      let displayedCount = 0;

      for (const like of uniqueLikes) {
        const post = postsBySlug.get(like.post_slug);

        // 対応する記事がない場合はスキップ
        if (!post) continue;

        // ブログ一覧と同じカードを作成
        const card = document.createElement("a");
        card.href = post.href;
        card.className = "card";

        // サムネイル
        if (post.thumbnail) {
          const image = document.createElement("img");

          image.className = "blog-thumbnail";
          image.src = post.thumbnail;
          image.alt = post.thumbnailAlt || post.title;
          image.loading = "lazy";
          image.width = 800;
          image.height = 450;

          card.append(image);
        } else {
          const placeholder = document.createElement("div");

          placeholder.className = "blog-thumbnail blog-no-image";

          const placeholderText = document.createElement("span");
          placeholderText.textContent = "Jaku Blog";

          placeholder.append(placeholderText);
          card.append(placeholder);
        }

        // カードの内容
        const content = document.createElement("div");
        content.className = "blog-card-content";

        // カテゴリー
        const category = document.createElement("small");
        category.textContent = post.category;

        // タイトル
        const title = document.createElement("h3");
        title.textContent = post.title;

        // 説明文
        const description = document.createElement("p");
        description.textContent = post.description || "";

        // 投稿日
        const date = document.createElement("small");
        date.textContent = post.date;

        content.append(
          category,
          title,
          description,
          date
        );

        // タグ
        if (post.tags?.length > 0) {
          const tags = document.createElement("div");
          tags.className = "blog-tags";

          for (const tag of post.tags) {
            const tagElement = document.createElement("span");
            tagElement.textContent = `#${tag}`;
            tags.append(tagElement);
          }

          content.append(tags);
        }

        card.append(content);
        list?.append(card);

        displayedCount++;
      }

      if (displayedCount > 0) {
        showStatus(`${displayedCount}件の記事にいいねしています。`);
      } else {
        showStatus("表示できる記事がありません。");
      }
    }

    // 初回読み込み
    void loadLikes();

    // ログイン状態の変化を監視
    supabase.auth.onAuthStateChange((event) => {
      if (event === "SIGNED_IN" || event === "SIGNED_OUT") {
        void loadLikes();
      }
    });
  </script>

  <style>
    .likes-page {
      width: min(1100px, calc(100% - 32px));
      margin: 0 auto;
      padding: 36px 0 88px;
      box-sizing: border-box;
    }

    .back-link {
      display: inline-block;
      margin-bottom: 24px;
      color: var(--text);
      opacity: 0.7;
      text-decoration: none;
      font-size: 14px;
      transition: opacity 160ms ease;
    }

    .back-link:hover {
      opacity: 1;
    }

    .status {
      margin: 0 0 20px;
      font-size: 14px;
      line-height: 1.8;
      opacity: 0.75;
    }

    .blog-thumbnail {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      border-radius: 12px;
    }

    .blog-no-image {
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--text);
      opacity: 0.65;
      font-size: 1.1rem;
      font-weight: 600;
      letter-spacing: 0.08em;
    }

    .blog-card-content {
      padding-top: 12px;
    }

    .blog-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
    }

    .blog-tags span {
      font-size: 0.8rem;
      opacity: 0.7;
    }

    .login-link {
      display: inline-block;
      width: fit-content;
      padding: 12px 18px;
      border-radius: 12px;
      background: var(--accent);
      color: white;
      text-decoration: none;
      font-size: 14px;
      transition: opacity 160ms ease;
    }

    .login-link:hover {
      opacity: 0.8;
    }

    @media (max-width: 600px) {
      .likes-page {
        padding-top: 24px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .back-link,
      .login-link {
        transition: none;
      }
    }
  </style>
</BaseLayout>
